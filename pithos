class ConfigError(Exception):
    pass


def clean(text):
    """Make untrusted text safe to print on a terminal (no escape sequences)."""
    return "".join(c if c.isprintable() or c in "\n\t" else f"\\x{ord(c):02x}" for c in str(text))


def note(msg):
    print(f"pithos: {msg}", file=sys.stderr)


def set_window_title(name, stream=None):
    """Inside tmux, name the window after the agent (needs `allow-rename on`)."""
    if not os.environ.get("TMUX"):
        return
    stream = stream or sys.stderr
    if not stream.isatty():
        return
    title = "".join(c for c in str(name) if c.isprintable())
    if not title:
        return
    stream.write(f"\033]2;{title}\007")
    stream.flush()


class Paths:
    def __init__(self, env=None):
        env = os.environ if env is None else env
        home = env.get("HOME", "")
        if not os.path.isabs(home):
            raise ConfigError("HOME must be an absolute path")
        self.home = os.path.realpath(home)
        self.config = os.path.realpath(
            env.get("PITHOS_CONFIG") or os.path.join(self.home, ".config/pithos"))
        self.state = os.path.realpath(
            env.get("PITHOS_STATE") or os.path.join(self.home, ".local/state/pithos"))

    @property
    def trusted(self):
        return os.path.join(self.state, "trusted.json")

    @property
    def logs(self):
        return os.path.join(self.state, "logs")

    @property
    def sessions(self):
        return os.path.join(self.state, "sessions")

    @property
    def allowed(self):
        return os.path.join(self.state, "allowed.json")

    def session_file(self, session):
        return os.path.join(self.sessions, session + ".json")


# -- configuration ---------------------------------------------------------------------

def validate(data, schema=SCHEMA, where="profile"):
    if not isinstance(data, dict):
        raise ConfigError(f"{where}: expected a table")
    for key, value in data.items():
        if key not in schema:
            raise ConfigError(f"{where}: unknown key {key!r}")
        kind = schema[key]
        name = f"{where}.{key}"
        if isinstance(kind, dict):
            validate(value, kind, name)
        elif kind == STR:
            if not isinstance(value, str):
                raise ConfigError(f"{name}: expected a {STR}")
        elif kind == BOOL:
            if not isinstance(value, bool):
                raise ConfigError(f"{name}: expected a {BOOL}")
        elif kind == AMOUNT:
            if isinstance(value, bool) or not isinstance(value, (int, str)):
                raise ConfigError(f"{name}: expected a {AMOUNT}")
        elif kind == LIST:
            if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
                raise ConfigError(f"{name}: expected a {LIST}")
        elif kind == MAP:
            if not isinstance(value, dict) or not all(isinstance(v, str) for v in value.values()):
                raise ConfigError(f"{name}: expected a {MAP}")


def merge(base, over):
    out = {}
    for section in ("fs", "net", "env", "ssh", "agent", "limits"):
        a, b = base.get(section, {}), over.get(section, {})
        merged = {}
        for key in a.keys() | b.keys():
            if key in a and key in b and isinstance(a[key], list):
                merged[key] = list(dict.fromkeys(a[key] + b[key]))
            elif key in a and key in b and isinstance(a[key], dict):
                merged[key] = {**a[key], **b[key]}
            else:
                merged[key] = b.get(key, a.get(key))
        out[section] = merged
    return out


def load_profile(paths, name, seen=()):
    if not PROFILE_NAME.match(name):
        raise ConfigError(f"invalid profile name {clean(name)!r}")
    if name in seen:
        raise ConfigError(f"profile inheritance loop: {' -> '.join(seen + (name,))}")
    path = os.path.join(paths.config, name + ".toml")
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        raise ConfigError(f"no profile {name!r} in {paths.config}")
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(f"{path}: {e}")
    validate(data, where=name)
    base = load_profile(paths, data["extends"], seen + (name,)) if "extends" in data else {}
    return merge(base, data)


def read_trusted(paths):
    try:
        with open(paths.trusted, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        note(f"ignoring unreadable {paths.trusted}: {e}")
        return {}
    if not isinstance(data, dict):
        return {}
    return {k: v for k, v in data.items() if isinstance(k, str) and isinstance(v, str)}


def read_project_file(project):
    """Return (bytes, sha256) of the project's config file, or (None, None)."""
    path = os.path.join(project, PROJECT_FILE)
    if not os.path.lexists(path):
        return None, None
    if os.path.islink(path) or not os.path.isfile(path):
        raise ConfigError(f"{path} must be a regular file, not a link")
    with open(path, "rb") as f:
        raw = f.read(1024 * 1024)
    return raw, hashlib.sha256(raw).hexdigest()


def parse_project_file(project, raw):
    try:
        data = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        raise ConfigError(f"{project}/{PROJECT_FILE}: {e}")
    validate(data, where=PROJECT_FILE)
    if "extends" in data:
        raise ConfigError(f"{PROJECT_FILE}: 'extends' is only allowed in profiles")
    for section in ("agent", "limits"):  # a cloned repo must not loosen these
        if section in data:
            raise ConfigError(f"{PROJECT_FILE}: '{section}' is only allowed in profiles")
    return data


def load_project(paths, project):
    raw, digest = read_project_file(project)
    if raw is None:
        return {}
    if read_trusted(paths).get(project) != digest:
        raise ConfigError(
            f"{project}/{PROJECT_FILE} is new or changed and not trusted.\n"
            f"Review it, then run: pithos trust -C {shlex.quote(project)}")
    return parse_project_file(project, raw)


def write_private_json(path, data):
    """Replace path atomically; mkstemp makes the file 0600."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, sort_keys=True)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


# -- hosts approved during a session ---------------------------------------------------
# Kept in the state dir, which the sandbox never sees. Session files last as long as their
# launcher; allowed.json maps a project to the hosts saved for all its sessions.

def read_json_table(path):
    """Return the JSON object in path, {} if the file is missing, None if it is unusable."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def read_live_entries(paths, session, project):
    """{source file: its entries for this session, or None if unusable}, for LiveAllowlist."""
    session_path = paths.session_file(session)
    record, saved = read_json_table(session_path), read_json_table(paths.allowed)
    return {session_path: None if record is None else record.get("allow", []),
            paths.allowed: None if saved is None else saved.get(project, [])}


def register_session(paths, session, project):
    os.makedirs(paths.sessions, mode=0o700, exist_ok=True)
    write_private_json(paths.session_file(session),
                       {"pid": os.getpid(), "project": project, "allow": []})


def running_sessions(paths):
    """{session: record} for live launchers. Files left by dead launchers are removed. A reused
    pid only keeps a stale file around: no proxy reads it."""
    sessions = {}
    for path in sorted(glob.glob(os.path.join(glob.escape(paths.sessions), "*.json"))):
        record = read_json_table(path)
        if not record or type(record.get("pid")) is not int or record["pid"] <= 0 \
                or not isinstance(record.get("project"), str):
            continue
        try:
            os.kill(record["pid"], 0)
        except (ProcessLookupError, OverflowError):
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)
            continue
        except PermissionError:
            pass
        sessions[os.path.basename(path)[: -len(".json")]] = record
    return sessions


@contextlib.contextmanager
def allow_lock(paths):
    os.makedirs(paths.sessions, mode=0o700, exist_ok=True)
    with open(os.open(os.path.join(paths.state, "allow.lock"), os.O_WRONLY | os.O_CREAT, 0o600),
              "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def entry_list(values, path):
    if not isinstance(values, list) or not all(isinstance(v, str) for v in values):
        raise ConfigError(f"{path} is damaged: fix or delete it")
    return values


def same_entry(a, b):
    """Compare canonically, falling back to the raw text for entries that no longer validate."""
    def canon(entry):
        try:
            return proxy.check_live_entry(entry)
        except ValueError:
            return entry
    return canon(a) == canon(b)


def update_entries(paths, sessions, project, change, save):
    """Apply change(list) -> list to each session file and, with save, the project's saved list."""
    with allow_lock(paths):
        for session in sessions:
            path = paths.session_file(session)
            record = read_json_table(path)
            if record == {}:
                continue  # the session ended a moment ago
            allow = entry_list(None if record is None else record.get("allow", []), path)
            write_private_json(path, {**record, "allow": change(allow)})
        if save:
            table = read_json_table(paths.allowed)
            saved = entry_list(None if table is None else table.get(project, []), paths.allowed)
            kept = change(saved)
            table = {k: v for k, v in table.items() if k != project}
            write_private_json(paths.allowed, {**table, project: kept} if kept else table)


def add_entries(paths, sessions, project, entries, save):
    update_entries(paths, sessions, project,
                   lambda old: list(dict.fromkeys(old + entries)), save)
    where = f"{len(sessions)} running session(s)"
    for entry in entries:
        print(clean(f"allowed {entry} in {where}" + ("; saved for this project" if save else "")))


def known_entries(paths, sessions, project):
    """Allowlist of the valid entries already approved for these sessions."""
    table = read_json_table(paths.allowed) or {}
    values = list(table.get(project, [])) if isinstance(table.get(project), list) else []
    for record in sessions.values():
        if isinstance(record.get("allow"), list):
            values += record["allow"]
    known = []
    for value in values:
        with contextlib.suppress(ValueError):
            known.append(proxy.check_live_entry(value))
    return proxy.Allowlist(known)


def parse_events(lines, stats=None):
    """Yield the JSON objects in a proxy log; anything else is counted in stats["bad"]."""
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            event = None
        if isinstance(event, dict):
            yield event
        elif stats is not None:
            stats["bad"] = stats.get("bad", 0) + 1


def offerable_host(event):
    """(host, port) if this log event may be offered for approval, else None. The sandbox picks
    these names, so only well-formed host names refused for not being listed qualify."""
    if event.get("action") != "deny" or event.get("reason") != proxy.NOT_LISTED:
        return None
    host, port = event.get("host"), event.get("port")
    try:
        if type(port) is not int or not 0 < port < 65536 \
                or proxy.normalize_host(host) != ("name", host):
            return None
    except (ValueError, AttributeError, TypeError):
        return None
    return host, port


def pending_hosts(paths, sessions, project):
    """[(entry, count)] for hosts refused only for not being listed, most denied first. The
    sandbox picks these names, so only well-formed host names are offered: IPs and wildcards
    need an explicit `pithos allow HOST`."""
    known = known_entries(paths, sessions, project)
    counts = {}
    for session in sessions:
        try:
            f = open(os.path.join(paths.logs, session + ".jsonl"), encoding="ascii",
                     errors="replace")
        except OSError:
            continue
        with f:
            for event in parse_events(f):
                offer = offerable_host(event)
                if offer and not known.allows("name", *offer):
                    key = proxy.live_entry(*offer)
                    counts[key] = counts.get(key, 0) + 1
    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))


# -- paths -----------------------------------------------------------------------------

def is_within(path, parent):
    return path == parent or path.startswith(parent.rstrip("/") + "/")


def project_slug(project):
    """The project's directory name under ~/.claude/projects: like JavaScript's
    path.replace(/[^a-zA-Z0-9]/g, "-"), which works on UTF-16 code units."""
    slug = "".join(c if c.isascii() and c.isalnum() else "-" * (1 + (ord(c) > 0xFFFF))
                   for c in project)
    if len(slug) > SLUG_MAX:
        raise ConfigError(f"project path too long for {{project_slug}}: {clean(project)!r}")
    return slug


def expand(value, project, paths):
    if "{project_slug}" in value:
        value = value.replace("{project_slug}", project_slug(project))
    value = value.replace("{project}", project)
    if value == "~" or value.startswith("~/"):
        value = paths.home + value[1:]
    if "{" in value or "}" in value:
        raise ConfigError(f"unknown placeholder in {clean(value)!r}")
    return value


def expand_path(value, project, paths):
    value = expand(value, project, paths)
    if not os.path.isabs(value):
        raise ConfigError(f"path must be absolute or start with ~ or {{project}}: {clean(value)!r}")
    return os.path.normpath(value)


def expand_glob(value, project, paths):
    """Like expand_path, but the substituted paths are escaped: only the profile's own
    wildcards act as glob syntax (a project named "app[1]" still matches itself)."""
    expand_path(value, project, paths)  # same validation and errors
    value = value.replace("{project_slug}", glob.escape(project_slug(project)))
    value = value.replace("{project}", glob.escape(project))
    if value == "~" or value.startswith("~/"):
        value = glob.escape(paths.home) + value[1:]
    return os.path.normpath(value)


def check_project(project, paths):
    if not os.path.isdir(project):
        raise ConfigError(f"project directory {clean(project)!r} does not exist")
    for p in (paths.home, paths.config, paths.state):
        if is_within(p, project):
            raise ConfigError(f"refusing {project} as project: it contains {p}")
    for p in [paths.config, paths.state] + SYSTEM_FORBIDDEN:
        if is_within(project, p) or is_within(p, project):
            raise ConfigError(f"refusing {project} as project: it is inside or contains {p}")


def check_bind(mode, src, dest, paths, denied):
    for p in (src, dest):
        if p == "/":
            raise ConfigError("refusing to bind /")
        for f in SYSTEM_FORBIDDEN:
            if is_within(p, f) or is_within(f, p):
                raise ConfigError(f"refusing to bind {p}: it is or contains {f}")
        for d in denied:
            if is_within(p, d):
                raise ConfigError(f"refusing to bind {p}: it is inside denied {d}")
        if mode == "rw":
            for f in (paths.home, paths.config, paths.state):
                if is_within(f, p):
                    raise ConfigError(f"refusing to bind {p} writable: it contains {f}")
            for f in (paths.config, paths.state):
                if is_within(p, f):
                    raise ConfigError(f"refusing to bind {p} writable: it is inside {f}")


def has_glob(value):
    return any(c in value for c in "*?[")


# -- resource limits -------------------------------------------------------------------
# Computed at start from what this machine has, so profiles can say "50%" instead of a size.
# The sandbox as a whole runs in a systemd scope (cgroup v2): systemd does the one privileged
# step, moving the launcher's child into a cgroup, and the kernel enforces the limits. pithos
# has no setuid code. Without a scope pithos refuses to run, unless --no-limits.

DEFAULT_LIMITS = {"processes": "15%", "memory": "50%", "total": "75%", "tmpfs": "25%",
                  "cpu": "100%"}
LIMIT_FLOORS = {"processes": 512, "memory": 1 << 30, "total": 1 << 30, "tmpfs": 64 << 20,
                "cpu": 100}
RUN_TMPFS_SIZE = 64 << 20  # /run only holds pithos's own files and a few sockets
SIZE_UNITS = {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}
SIZE_VALUE = re.compile(r"(\d{1,15})([KMGT]?)")
PERCENT_VALUE = re.compile(r"(\d{1,3}(?:\.\d{1,2})?)%")
COUNTED = ("processes", "cpu")  # a count (tasks, cores), not a size


class Machine:
    """What limits are computed against: RAM (lowered by our own cgroup's limit, as in a
    container), how many tasks the user may run and how many CPUs we may use."""

    def __init__(self, ram, tasks, cpus=1):
        self.ram, self.tasks, self.cpus = ram, tasks, cpus

    def base(self, key):
        """The whole of what a limit is a share of. cpu is in percent of one CPU, like
        systemd's CPUQuota: 4 CPUs are 400."""
        return {"processes": self.tasks, "cpu": self.cpus * 100}.get(key, self.ram)


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def cgroup_memory_limit(proc="/proc", sysfs="/sys/fs/cgroup"):
    """The lowest memory.max of our cgroup and its ancestors (cgroup v2), or None."""
    try:
        with open(os.path.join(proc, "self/cgroup")) as f:
            line = next((l for l in f if l.startswith("0::")), "")
    except OSError:
        return None
    rel = os.path.normpath(line[3:].strip() or "/").strip("/")
    limits = []
    while True:
        value = read_int(os.path.join(sysfs, rel, "memory.max"))  # "max" reads as None
        if value:
            limits.append(value)
        if not rel:
            break
        rel = os.path.dirname(rel)
    return min(limits, default=None)


def read_machine(proc="/proc", sysfs="/sys/fs/cgroup"):
    ram = None
    try:
        with open(os.path.join(proc, "meminfo")) as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    ram = int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    if not ram:
        raise ConfigError("cannot read MemTotal from /proc/meminfo to compute [limits]")
    group = cgroup_memory_limit(proc, sysfs)
    soft = resource.getrlimit(resource.RLIMIT_NPROC)[0]
    tasks = [n for n in (None if soft == resource.RLIM_INFINITY else soft,
                         read_int(os.path.join(proc, "sys/kernel/threads-max"))) if n]
    return Machine(min(ram, group or ram), min(tasks, default=1 << 22),
                   len(os.sched_getaffinity(0)) or 1)


def parse_limit(key, value, machine, warnings):
    """Bytes, a task count or a CPU quota (percent of one CPU) for one [limits] value, or None
    for "none". A limit that grants the whole machine is None too: nothing to enforce."""
    where = f"limits.{key}"
    base = machine.base(key)
    if value == "none":
        return None
    if isinstance(value, int):
        amount, absolute = value * (100 if key == "cpu" else 1), True
    elif m := PERCENT_VALUE.fullmatch(value):
        percent = float(m.group(1))
        if not 0 < percent <= 100:
            raise ConfigError(f"{where}: percentage must be between 0 and 100: {clean(value)!r}")
        amount, absolute = int(base * percent / 100), False
    elif (m := SIZE_VALUE.fullmatch(value)) and (key not in COUNTED or not m.group(2)):
        amount = int(m.group(1)) * SIZE_UNITS[m.group(2)] * (100 if key == "cpu" else 1)
        absolute = True
    else:
        example = {"processes": '"4096" or "15%"', "cpu": '"2" (CPUs) or "50%"'}.get(
            key, '"16G" or "50%"')
        raise ConfigError(f"{where}: expected {example} or \"none\", got {clean(value)!r}")
    if amount <= 0:
        raise ConfigError(f"{where}: must be more than 0")
    if absolute and amount > base:
        warnings.append(f"{where}: {clean(value)} is more than this machine has, using "
                        f"{describe_amount(key, base)}")
    # Floors only lift the computed percentage defaults: an explicit value is used as given.
    amount = min(amount if absolute else max(amount, LIMIT_FLOORS[key]), base)
    return None if key == "cpu" and amount >= base else amount


def resolve_limits(cfg, machine):
    """({key: amount or None}, warnings). Missing keys get DEFAULT_LIMITS."""
    given = cfg.get("limits", {})
    warnings = []
    limits = {key: parse_limit(key, given.get(key, DEFAULT_LIMITS[key]), machine, warnings)
              for key in LIMIT_KEYS}
    # A per-process ceiling above the sandbox's own can never be reached: the whole sandbox
    # hits its limit first. Say so instead of leaving dead config.
    if limits["memory"] and limits["total"] and limits["memory"] > limits["total"]:
        warnings.append(f"limits.memory: {describe_amount('memory', limits['memory'])} is more "
                        f"than the sandbox's total ({describe_amount('total', limits['total'])}), "
                        f"using {describe_amount('total', limits['total'])}")
        limits["memory"] = limits["total"]
    return limits, warnings


def describe_amount(key, amount):
    if amount is None:
        return "unlimited"
    if key == "processes":
        return str(amount)
    if key == "cpu":
        return f"{amount / 100:g} CPUs"
    for unit in ("T", "G", "M", "K"):
        if amount >= SIZE_UNITS[unit]:
            return f"{amount / SIZE_UNITS[unit]:.1f}{unit}".replace(".0", "")
    return str(amount)


LIMIT_NAMES = {"processes": "processes", "memory": "memory per process",
               "total": "memory in total", "tmpfs": "tmpfs each", "cpu": "cpu"}


def describe_limits(limits, keys=LIMIT_KEYS):
    return ", ".join(f"{LIMIT_NAMES[key]} {describe_amount(key, limits[key])}" for key in keys)


def bridge_limits(limits, scoped=True):
    """The rlimits for bridge.py, as "name=value,...". Core dumps are always off: they would
    hold the agent's memory, keys included. In a scope, TasksMax limits processes and reports
    when it is hit; RLIMIT_NPROC is only the fallback for --no-limits."""
    parts = ["core=0"]
    if limits and limits.get("processes") and not scoped:
        parts.append(f"nproc={limits['processes']}")
    if limits and limits.get("memory"):
        parts.append(f"data={limits['memory']}")
    return ",".join(parts)


SYSTEMD_RUN_PATHS = ("/usr/bin/systemd-run", "/bin/systemd-run")


def find_systemd_run():
    """Only from the system's own directories: never PATH, which the user's shell can change."""
    return next((p for p in SYSTEMD_RUN_PATHS if os.access(p, os.X_OK)), None)


def scope_argv(systemd_run, unit, limits):
    """Prefix that runs the rest of the argv in a new systemd scope. --scope execs it in place,
    so bwrap stays the launcher's child and inherits its file descriptors."""
    argv = [systemd_run, "--user", "--scope", "--quiet", "--collect", f"--unit={unit}",
            "-p", "OOMPolicy=continue"]  # without it, an OOM kill fails the scope and takes it all down
    if limits.get("total"):
        argv += ["-p", f"MemoryMax={limits['total']}", "-p", "MemorySwapMax=0"]
    if limits.get("processes"):
        argv += ["-p", f"TasksMax={limits['processes']}"]
    if limits.get("cpu"):
        argv += ["-p", f"CPUQuota={limits['cpu']}%"]
    return argv + ["--"]


def check_scope(systemd_run):
    """None if a user scope can be created here, else why not."""
    if not systemd_run:
        return "systemd-run is not installed"
    if not os.path.isabs(os.environ.get("XDG_RUNTIME_DIR", "")):
        return "no systemd user session (XDG_RUNTIME_DIR is not set)"
    try:
        done = subprocess.run([systemd_run, "--user", "--scope", "--quiet", "--collect", "--",
                               "/bin/true"], stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, errors="replace", timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"systemd-run failed: {e}"
    if done.returncode != 0:
        lines = done.stderr.strip().splitlines()
        return f"systemd-run failed: {clean(lines[-1] if lines else done.returncode)}"
    return None


def limits_notice(limits, scoped):
    enforced = [key for key in (LIMIT_KEYS if scoped else ("processes", "memory", "tmpfs"))
                if limits.get(key)]
    if not enforced:
        return ""
    text = f"""
## Resource limits

This sandbox limits {describe_limits(limits, enforced)}. Processes include threads; "memory in
total" includes files in /tmp, /var/tmp, /dev/shm and the home directory, which are in memory;
"tmpfs each" is the size of each of those. When a command ends with "Killed" or exit code 137,
or fails with "Resource temporarily unavailable", "Cannot allocate memory", an out-of-memory
error or "No space left on device" in those directories, it may have hit one of these limits."""
    if scoped:
        text += f""" Read `{SANDBOX_LIMIT_EVENTS}`: it lists, one per line as `time<TAB>limit<TAB>what
happened`, each time a limit stopped something in this session."""
    return text + """ If a limit was hit, tell the user which one and what it stopped; they can
raise it under `[limits]` in their pithos profile. Do not try to get around it.
"""


class LimitEvents:
    """The list of limits hit this session, for the agent. Every byte is pithos's own: a time,
    a fixed text and numbers. Bind-mounted read-only, so appended to and never replaced."""

    def __init__(self, path, limits, log=None, clock=None):
        self.path, self.limits, self.log = path, limits, log
        self.clock = clock or (lambda: time.strftime("%H:%M:%S"))
        self.lines = 0
        self.totals = {}

    def add(self, kind, count):
        self.totals[kind] = self.totals.get(kind, 0) + count
        if kind == "memory":
            what = (f"the kernel killed {count} process{'es' if count > 1 else ''}: the sandbox "
                    f"reached its memory limit ({describe_amount('total', self.limits['total'])})")
        else:
            what = (f"{count} process or thread start{'s' if count > 1 else ''} refused: the "
                    f"sandbox reached its limit of {self.limits['processes']} processes")
        if self.log:
            self.log(action="limit", limit=kind, count=count)
        if self.lines > LIMIT_EVENTS_LIMIT:
            return
        self.lines += 1
        line = (f"{self.clock()}\t{kind}\t{what}\n" if self.lines <= LIMIT_EVENTS_LIMIT else
                "list truncated: the user can see the rest with pithos report\n")
        try:
            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND)
            try:
                os.write(fd, line.encode("ascii"))
            finally:
                os.close(fd)
        except OSError:
            pass


LIMIT_EVENTS_LIMIT = 200
LIMIT_COUNTERS = {"memory": ("memory.events", "oom_kill"), "processes": ("pids.events", "max")}
EVENTS_INTERVAL = 1.0  # at most one line per kind and second, however fast a fork loop is


def read_counter(fd, name):
    try:
        text = os.pread(fd, 4096, 0).decode("ascii", "replace")
    except OSError:
        return None
    for line in text.splitlines():
        key, _, value = line.partition(" ")
        if key == name and value.isdigit():
            return int(value)
    return None


class ScopeMonitor:
    """Watches the scope's event counters and reports each increase to LimitEvents. The
    kernel wakes poll() when an events file changes; nothing here enforces anything."""

    def __init__(self, cgroup_dir, events):
        self.dir, self.events = cgroup_dir, events
        self.fds, self.seen = {}, {}
        self.stopping = threading.Event()
        self.thread = None

    def start(self):
        for kind, (name, counter) in LIMIT_COUNTERS.items():
            try:
                fd = os.open(os.path.join(self.dir, name), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            except OSError:
                continue
            self.fds[kind] = fd
            self.seen[kind] = read_counter(fd, counter) or 0
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def check(self):
        for kind, fd in self.fds.items():
            value = read_counter(fd, LIMIT_COUNTERS[kind][1])
            if value is not None and value > self.seen[kind]:
                self.events.add(kind, value - self.seen[kind])
                self.seen[kind] = value

    def _run(self):
        poller = select.poll()
        for fd in self.fds.values():
            poller.register(fd, select.POLLPRI | select.POLLERR)
        while not self.stopping.is_set():
            try:
                poller.poll(EVENTS_INTERVAL * 1000)
                self.check()
            except Exception:
                pass
            self.stopping.wait(EVENTS_INTERVAL)

    def stop(self):
        self.stopping.set()
        if self.thread:
            self.thread.join(5)
            self.thread = None
        with contextlib.suppress(Exception):
            self.check()  # the files read as errors once the scope is gone
        for fd in self.fds.values():
            os.close(fd)
        self.fds = {}


def scope_cgroup(pid, unit, proc="/proc", sysfs="/sys/fs/cgroup", timeout=5.0):
    """The scope's cgroup directory once systemd-run has moved pid into it, or None."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with open(f"{proc}/{pid}/cgroup") as f:
                rel = next((l[3:].strip() for l in f if l.startswith("0::")), "")
        except OSError:
            return None
        if rel.endswith("/" + unit) and ".." not in rel.split("/"):
            return sysfs + rel
        time.sleep(0.02)
    return None


# -- sandbox plan ----------------------------------------------------------------------

class Plan:
    def __init__(self):
        self.mounts = []  # (dest, order, [bwrap args])
        self.overlays = []  # [bwrap args], applied after every bind
        self.env = {}
        self.skipped = []
        self.mkdirs = []  # host directories to create before starting bwrap
        self.copies = []  # (host file, private copy) made before starting bwrap
        self.notices = []  # (host file, generated file): host file + notice_text
        self.notice_text = AGENT_NOTICE
        self.watch = []  # ro_in_project paths missing at start: checked again after exit
        self.project = None
        self.gitdirs = []  # submodule git dirs found at start
        self.hidden = []  # plain deny paths and the paths deny overlays cover
        self.deny_globs = []
        self.tmpfs = {}  # writable tmpfs in the sandbox: its size, or None if unlimited
        self.limits = None
        self.scoped = True  # limits.total, processes and cpu are enforced by a systemd scope

    def mount(self, dest, order, args):
        self.mounts.append((dest, order, args))


def submodule_gitdirs(project):
    """Return (git dirs, links) under .git/modules, relative to the project. A git dir is a
    directory holding HEAD; nested submodules live in its own modules/ subdirectory."""
    gitdirs, links, todo, seen = [], [], [SUBMODULES], 0
    while todo:
        rel = todo.pop()
        path = os.path.join(project, rel)
        seen += 1
        if seen > SUBMODULE_SCAN_LIMIT:
            raise ConfigError(f"too many directories under {clean(project)}/{SUBMODULES}")
        if os.path.islink(path):
            links.append(rel)
        elif not os.path.isdir(path):
            continue
        elif os.path.isfile(os.path.join(path, "HEAD")):
            gitdirs.append(rel)
            todo.append(rel + "/modules")
        else:
            todo += [f"{rel}/{name}" for name in sorted(os.listdir(path))]
    return sorted(gitdirs), sorted(links)


def build_plan(cfg, project, paths, runtime, environ=None, limits=None):
    environ = os.environ if environ is None else environ
    fs, env_cfg = cfg.get("fs", {}), cfg.get("env", {})
    plan = Plan()

    deny_plain = [expand_path(d, project, paths) for d in fs.get("deny", []) if not has_glob(d)]
    deny_globs = [expand_glob(d, project, paths) for d in fs.get("deny", []) if has_glob(d)]
    # Plain deny paths also forbid binding anything inside them (e.g. ro = ["~/.ssh/id_rsa"]).
    denied_roots = [os.path.realpath(d) for d in deny_plain]

    binds = []  # (mode, src, dest)
    for key in ("rw", "rw_mkdir", "ro"):
        mode = "ro" if key == "ro" else "rw"
        for value in fs.get(key, []):
            dest = expand_path(value, project, paths)
            src = os.path.realpath(dest)
            check_bind(mode, src, dest, paths, denied_roots)
            if key == "rw_mkdir":
                if os.path.lexists(src) and not os.path.isdir(src):
                    raise ConfigError(f"fs.rw_mkdir: {dest} exists and is not a directory")
                if not os.path.lexists(src):
                    plan.mkdirs.append(src)
            elif not os.path.lexists(dest):
                plan.skipped.append(f"{mode} {dest} (missing)")
                continue
            binds.append((mode, src, dest))
    # Writable private copies: the sandbox may change them, nothing it writes persists.
    for n, value in enumerate(fs.get("copy", [])):
        dest = expand_path(value, project, paths)
        src = os.path.realpath(dest)
        check_bind("rw", src, dest, paths, denied_roots)
        if not os.path.lexists(dest):
            plan.skipped.append(f"copy {dest} (missing)")
            continue
        if not os.path.isfile(src):
            raise ConfigError(f"fs.copy: {dest} is not a regular file")
        copy = os.path.join(runtime, f"copy-{n}")
        plan.copies.append((src, copy))
        plan.mount(dest, 1, ["--bind", copy, dest])
        binds.append(("copy", src, dest))
    plan.project = project
    plan.gitdirs, links = submodule_gitdirs(project)
    if links:
        raise ConfigError(f"{clean(project)}/{links[0]} is a link: can't protect submodule hooks")
    submodule_files = [f"{g}/{name}" for g in plan.gitdirs for name in GITDIR_FILES]
    for rel in ALWAYS_RO_IN_PROJECT + fs.get("ro_in_project", []) + submodule_files:
        if os.path.isabs(rel) or ".." in rel.split("/"):
            raise ConfigError(f"fs.ro_in_project entries must be relative: {clean(rel)!r}")
        dest = os.path.normpath(os.path.join(project, rel))
        if not os.path.lexists(dest):
            plan.skipped.append(f"ro_in_project {dest} (missing)")
            plan.watch.append(dest)
            continue
        src = os.path.realpath(dest)
        if not is_within(src, project):
            raise ConfigError(f"{dest} links outside the project ({src})")
        # Pin every ancestor (.git, .claude) as a mount point: otherwise the sandbox can
        # rename it away (mv .git .git.x) and recreate the protected file writable.
        anc = os.path.dirname(dest)
        while anc != project:
            if os.path.islink(anc):
                raise ConfigError(f"{anc} is a link: can't protect {dest} inside it")
            binds.append(("rw", anc, anc))
            anc = os.path.dirname(anc)
        binds.append(("ro", src, dest))

    if "notice_into" in cfg.get("agent", {}):
        dest = expand_path(cfg["agent"]["notice_into"], project, paths)
        src = os.path.realpath(dest)
        check_bind("ro", src, dest, paths, denied_roots)
        if os.path.lexists(src) and not os.path.isfile(src):
            raise ConfigError(f"agent.notice_into: {dest} is not a regular file")
        notice = os.path.join(runtime, "agent-notice.md")
        plan.notices.append((src, notice))
        plan.mount(dest, 3, ["--ro-bind", notice, dest])  # over the fs.ro bind of the same file

    for mode, src, dest in dict.fromkeys(binds):
        if mode == "copy":
            continue
        check_bind(mode, src, dest, paths, denied_roots)
        flag = "--bind" if mode == "rw" else "--ro-bind"
        plan.mount(dest, 1 if mode == "rw" else 2, [flag, src, dest])

    # Every writable tmpfs is sized: they are RAM. / and /dev are made read-only at the end of
    # bwrap's argv (bwrap_argv), so these and the binds are the only places to write.
    size = ["--size", str(limits["tmpfs"])] if limits and limits.get("tmpfs") else []
    for dest in (paths.home, "/tmp", "/var/tmp", "/dev/shm"):
        plan.mount(dest, 0, [*size, "--tmpfs", dest])
        plan.tmpfs[dest] = limits["tmpfs"] if size else None
    plan.mount("/run", 0, ["--size", str(RUN_TMPFS_SIZE), "--tmpfs", "/run"])
    plan.tmpfs["/run"] = RUN_TMPFS_SIZE
    plan.limits = limits
    plan.mount(SANDBOX_RUN + "/proxy.sock", 1,
               ["--bind", os.path.join(runtime, "proxy.sock"), SANDBOX_RUN + "/proxy.sock"])
    plan.mount(SANDBOX_RUN + "/bridge.py", 2,
               ["--ro-bind", os.path.join(HERE, "bridge.py"), SANDBOX_RUN + "/bridge.py"])
    for name, dest in (("blocked-hosts", SANDBOX_BLOCKED_HOSTS), ("blocked-files", SANDBOX_BLOCKED_FILES),
                       ("limit-events", SANDBOX_LIMIT_EVENTS),
                       ("notice.md", SANDBOX_NOTICE), ("opencode.json", SANDBOX_OPENCODE_CONFIG)):
        plan.mount(dest, 2, ["--ro-bind", os.path.join(runtime, name), dest])
    if cfg.get("agent", {}).get("connect_claude_agent"):
        plan.mount(SANDBOX_CLAUDE_AGENT, 2, ["--ro-bind", os.path.join(runtime, "claude-agent.json"),
                                             SANDBOX_CLAUDE_AGENT])
    usr_bound = any(dest == "/usr" for _, _, dest in binds)
    for link in SYSTEM_SYMLINKS:
        if usr_bound and os.path.islink(link):
            plan.mount(link, 0, ["--symlink", os.readlink(link), link])

    # Deny overlays: hide matches that would otherwise be visible through a bind.
    visible = [dest for _, _, dest in binds]
    empty = os.path.join(runtime, "empty")
    matches = deny_plain + [paths.state]
    for pattern in deny_globs:
        matches += glob.glob(pattern, recursive=True, include_hidden=True)
    hidden = []
    for match in dict.fromkeys(matches):
        if not os.path.lexists(match):
            continue
        # A denied symlink (~/.ssh -> dotfiles/ssh) hides its target wherever a bind shows it.
        real = os.path.realpath(match)
        targets = [] if os.path.islink(match) else [match]
        targets += [os.path.join(dest, os.path.relpath(real, src)) for _, src, dest in binds
                    if is_within(real, src)]
        for target in dict.fromkeys(os.path.normpath(t) for t in targets):
            if target in hidden or not any(is_within(target, v) for v in visible):
                continue
            hidden.append(target)
            if os.path.isdir(real):
                plan.overlays += [["--tmpfs", target], ["--remount-ro", target]]
            else:
                plan.overlays.append(["--ro-bind", empty, target])
    plan.hidden = list(dict.fromkeys(deny_plain + hidden))
    plan.deny_globs = deny_globs

    env = {
        "HOME": paths.home,
        "USER": environ.get("USER", "agent"),
        "LOGNAME": environ.get("USER", "agent"),
        "SHELL": "/bin/bash",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "PITHOS": "1",
    }
    for name in env_cfg.get("pass", []):
        if not ENV_NAME.match(name):
            raise ConfigError(f"invalid env.pass name {clean(name)!r}")
        if name in environ:
            env[name] = environ[name]
    for name, value in env_cfg.get("set", {}).items():
        if not ENV_NAME.match(name):
            raise ConfigError(f"invalid env.set name {clean(name)!r}")
        env[name] = ":".join(expand(part, project, paths) for part in value.split(":"))
    for name in ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy"):
        env[name] = PROXY_URL
    env.update(NO_PROXY=NO_PROXY, no_proxy=NO_PROXY, NODE_USE_ENV_PROXY="1",
               PITHOS_BLOCKED_HOSTS=SANDBOX_BLOCKED_HOSTS, PITHOS_BLOCKED_FILES=SANDBOX_BLOCKED_FILES,
               PITHOS_LIMIT_EVENTS=SANDBOX_LIMIT_EVENTS)
    for name in ("ALL_PROXY", "all_proxy"):
        env.pop(name, None)
    if cfg.get("agent", {}).get("connect_claude_agent") and "XDG_DATA_HOME" not in env:
        raise ConfigError("agent.connect_claude_agent: needs XDG_DATA_HOME in env.set")
    if any("\0" in v for v in env.values()):
        raise ConfigError("environment values must not contain NUL")
    plan.env = env
    return plan


def make_dirs(plan):
    for path in plan.mkdirs:
        os.makedirs(path, mode=0o700, exist_ok=True)
        if os.path.realpath(path) != path:
            raise ConfigError(f"{path} changed into a link while being created")
    for src, copy in plan.copies:
        with open(src, "rb") as f, open(os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600),
                                       "wb") as out:
            shutil.copyfileobj(f, out)
    for src, target in plan.notices:
        try:
            with open(src, "rb") as f:
                text = f.read(NOTICE_SOURCE_LIMIT)
        except FileNotFoundError:
            text = b""
        write_private(target, text + b"\n" + plan.notice_text.encode())


def write_private(path, data):
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as f:
        f.write(data)


def write_runtime_files(runtime, notice=AGENT_NOTICE):
    """Files that build_plan binds into the sandbox, one by one, read-only."""
    write_private(os.path.join(runtime, "empty"), b"")
    write_private(os.path.join(runtime, "blocked-hosts"), b"")
    write_private(os.path.join(runtime, "blocked-files"), b"")
    write_private(os.path.join(runtime, "limit-events"), b"")
    write_private(os.path.join(runtime, "notice.md"), notice.encode())
    write_private(os.path.join(runtime, "opencode.json"),
                  json.dumps({"instructions": [SANDBOX_NOTICE]}).encode())
    write_private(os.path.join(runtime, "claude-agent.json"),
                  json.dumps(CLAUDE_AGENT_CREDENTIAL).encode())


def agent_command(cfg, cmd):
    """The command to run in the sandbox; cmd stays argv, never part of the script text."""
    if cfg.get("agent", {}).get("connect_claude_agent") and os.path.basename(cmd[0]) == "opencode":
        return ["sh", "-c", CONNECT_CLAUDE_AGENT, "sh", *cmd]
    return cmd


def quarantine(plan, session):
    """Move aside ro_in_project paths the sandbox created (they were missing at start), so
    host tools don't run them. Returns the paths moved."""
    moved = []
    for path in plan.watch:
        if not os.path.lexists(path):
            continue
        parent = os.path.dirname(path)
        if os.path.realpath(parent) != parent:
            note(f"WARNING: {clean(path)} appeared during the session behind a link; check it")
            continue
        target = f"{path}.pithos-quarantine-{session}"
        os.rename(path, target)
        moved.append(target)
    # Submodule git dirs and links that appeared under .git/modules during the session.
    if plan.project and os.path.realpath(os.path.join(plan.project, ".git")) == \
            os.path.join(plan.project, ".git"):
        try:
            gitdirs, links = submodule_gitdirs(plan.project)
        except ConfigError as e:
            note(f"WARNING: {e}; check {SUBMODULES} by hand")
            return moved
        new = [os.path.join(plan.project, g, name) for g in gitdirs if g not in plan.gitdirs
               for name in GITDIR_FILES] + [os.path.join(plan.project, rel) for rel in links]
        for path in new:
            if os.path.lexists(path):
                target = f"{path}.pithos-quarantine-{session}"
                os.rename(path, target)
                moved.append(target)
    return moved


def tiocsti_disabled():
    try:
        with open("/proc/sys/dev/tty/legacy_tiocsti") as f:
            return f.read().strip() == "0"
    except OSError:
        return False


def env_args(plan):
    out = []
    for name, value in sorted(plan.env.items()):
        out += ["--setenv", name, value]
    return out


def bwrap_argv(bwrap, plan, project, cmd, env_fd=None):
    """With env_fd, the environment is read from that fd (bwrap --args), so values stay out
    of the world-readable /proc/<pid>/cmdline; without it, values are shown redacted."""
    argv = [bwrap, "--unshare-all", "--unshare-user", "--disable-userns", "--die-with-parent",
            "--clearenv", "--hostname", "pithos", "--proc", "/proc", "--dev", "/dev"]
    if not tiocsti_disabled():
        # Without the kernel's TIOCSTI lockdown, a sandboxed process could type into the
        # parent terminal; a new session prevents that (at the cost of job control).
        argv.append("--new-session")
    for _, _, args in sorted(plan.mounts, key=lambda m: (m[0].count("/"), m[1])):
        argv += args
    for args in plan.overlays:
        argv += args
    # bwrap's / and /dev are unsized tmpfs: read-only, they can't be used to fill RAM. Mounts
    # under them (binds, the sized tmpfs above) keep their own modes.
    argv += ["--remount-ro", "/dev", "--remount-ro", "/"]
    if env_fd is None:
        for name in sorted(plan.env):
            argv += ["--setenv", name, "<redacted>"]
    else:
        argv += ["--args", str(env_fd)]
    argv += ["--chdir", project, "--", SANDBOX_PYTHON, "-I", SANDBOX_RUN + "/bridge.py", "serve",
             SANDBOX_RUN + "/proxy.sock", "3128", bridge_limits(plan.limits, plan.scoped), *cmd]
    return argv


def check_bwrap(bwrap):
    """--size sizes the tmpfs mounts; without it they would be unlimited RAM. Older bubblewrap
    has no --size, and its own error would be cryptic."""
    try:
        done = subprocess.run([bwrap, "--help"], capture_output=True, text=True, errors="replace",
                              timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise ConfigError(f"cannot run {clean(bwrap)}: {e}")
    if done.returncode != 0 or "--size" not in done.stdout:
        raise ConfigError(f"{clean(bwrap)} is too old: pithos needs bubblewrap 0.6 or newer, "
                          f"for the sized tmpfs mounts")


def strace_argv(strace, out_path, argv, failed_only=True):
    """-D keeps bwrap the launcher's direct child, so --die-with-parent, exit codes and signal
    forwarding are unchanged. --seccomp-bpf stops only on file syscalls, -Z prints only the
    failed ones. Never add -v: it would print environment values on execve."""
    opts = [strace, "-D", "-f", "-qq", "-y", "--seccomp-bpf", "-e", "trace=%file",
            "-e", "signal=none"]
    if failed_only:
        opts.append("-Z")
    return [*opts, "-o", out_path, *argv]


def ptrace_allowed():
    """Yama scope 0 or 1 lets strace trace its own children; 2 and 3 need privileges."""
    try:
        with open("/proc/sys/kernel/yama/ptrace_scope") as f:
            return int(f.read().strip()) < 2
    except (OSError, ValueError):
        return True  # no Yama


def create_trace_log(path):
    """Created here so strace's -o can't follow a planted link and the log stays private."""
    try:
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600))
    except OSError as e:
        raise ConfigError(f"cannot create trace log {path}: {e.strerror}")


TRACE_LINE = re.compile(r"(\d+)\s+(.*)$")
TRACE_CALL = re.compile(r"(\w+)\((.*)$")
TRACE_STRING = re.compile(r'"((?:[^"\\]|\\.)*)"')
TRACE_DIRFD = re.compile(r"(?:\d+|AT_FDCWD)<(.*?)>, ")
TRACE_ESCAPE = re.compile(r"\\(x[0-9a-fA-F]{2}|[0-7]{1,3}|.)", re.S)
TRACE_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "v": "\v", "f": "\f", "a": "\a", "b": "\b"}
TRACE_LINE_MAX = 65536
TRACE_STARTS = (f'execve("{SANDBOX_PYTHON}"',)  # traces from before the start probe
TRACE_ERROR = re.compile(r"\) += -1 (E[A-Z0-9]+) \([^()]*\)$")
TRACE_WRITE_FLAGS = re.compile(r"\bO_(?:WRONLY|RDWR|CREAT|TRUNC)\b")
TRACE_WRITE_CALLS = re.compile(
    r"(?:mkdir|mknod|unlink|rmdir|rename|link|symlink|creat|truncate|f?chmod|f?chown|lchown|utime)")
TRACE_MISSING = ("ENOENT", "ENOTDIR")
TRACE_GROUPS = ("written", "read", "missing", "refused")


def trace_calls(lines):
    """Yield complete `call(args) = result` texts, joining the halves strace splits when
    threads interleave. Anything else in the file is ignored."""
    pending = {}
    for line in lines:
        m = TRACE_LINE.match(line.rstrip("\n"))
        if not m:
            continue
        pid, text = m.groups()
        if text.endswith(" <unfinished ...>"):
            pending[pid] = text[:-len(" <unfinished ...>")]
        elif text.startswith("<... "):
            head = pending.pop(pid, None)
            if head is not None and " resumed>" in text:
                yield head + text.split(" resumed>", 1)[1]
        else:
            yield text


def trace_unescape(text):
    """Undo strace's C-style string escapes; bytes that aren't UTF-8 stay visible as \\xNN."""
    raw, pos = bytearray(), 0
    for m in TRACE_ESCAPE.finditer(text):
        raw += text[pos:m.start()].encode("utf-8", "surrogateescape")
        code = m.group(1)
        if code[0] == "x" and len(code) == 3:
            raw.append(int(code[1:], 16))
        elif code[0] in "01234567":
            raw.append(int(code, 8) & 0xFF)
        else:
            raw += TRACE_ESCAPES.get(code, code).encode("utf-8", "surrogateescape")
        pos = m.end()
    raw += text[pos:].encode("utf-8", "surrogateescape")
    return raw.decode("utf-8", "backslashreplace")


def parse_trace_call(text):
    """(call, paths, error name or None, writes) for one call, or None if it names no path."""
    m = TRACE_CALL.match(text)
    if not m:
        return None
    call, args = m.groups()
    strings = list(TRACE_STRING.finditer(args))
    if not strings:
        return None
    first = strings[0]
    names = [trace_unescape(s.group(1)) for s in strings]
    if call.startswith(("rename", "link")):
        chosen = names[:2]
    elif call.startswith("symlink"):
        chosen = names[1:2]
    else:
        chosen = names[:1]
    dirfd = TRACE_DIRFD.match(args)
    base = trace_unescape(dirfd.group(1)) if dirfd and dirfd.end() == first.start() else ""
    found = [os.path.join(base, name) for name in chosen if name]
    if not found:
        return None
    error = TRACE_ERROR.search(text)
    flags = args[first.end():].split(") = ", 1)[0]
    writes = bool(TRACE_WRITE_FLAGS.search(flags) or TRACE_WRITE_CALLS.match(call))
    return call, found, error.group(1) if error else None, writes


def classify_trace_call(text):
    """Return (group, paths) for one call, or None if it names no path."""
    parsed = parse_trace_call(text)
    if not parsed:
        return None
    _, found, error, writes = parsed
    if error:
        return ("missing" if error in TRACE_MISSING else "refused"), found
    return ("written" if writes else "read"), found


def sandbox_calls(lines):
    """trace_calls after the sandbox starts. Bwrap's own setup comes before the bridge's start
    probe (older traces: the bridge's execve) and is skipped; so is the probe itself."""
    started = False
    probe = f'"{TRACE_START}"'
    for text in trace_calls(lines):
        if probe in text:
            started = True
        elif started:
            yield text
        else:
            started = text.startswith(TRACE_STARTS)


def summarise_trace(lines):
    """Count paths per group. A trace that never reaches the bridge counts nothing."""
    groups = {name: {} for name in TRACE_GROUPS}
    for text in sandbox_calls(lines):
        result = classify_trace_call(text)
        if result:
            counts = groups[result[0]]
            for path in result[1]:
                counts[path] = counts.get(path, 0) + 1
    return groups


# -- telling the agent about refused file accesses -------------------------------------
# strace reports failed file syscalls live. Each is classified against the plan, never
# against the host: checking the host would tell the sandbox which host paths exist.

NOT_MOUNTED = "not mounted"
HIDDEN = "hidden on purpose"
READ_ONLY = "read-only"
FILE_ERRORS = ("ENOENT", "ENOTDIR", "EROFS", "EACCES", "EPERM")
FILE_PATH_MAX = 4096
BLOCKED_FILES_LIMIT = 2000
BLOCKED_GROUP_LIMIT = 100
FILE_EVENTS_LIMIT = 5000
# Looked up by nearly every program, and never worth mounting.
IGNORED_PROBES = ("/etc/ld.so.preload", "/etc/ld.so.nohwcap", "/etc/selinux", "/selinux",
                  "/etc/gai.conf", "/etc/host.conf", "/etc/resolv.conf")
MOUNT_KINDS = {"--bind": "rw", "--ro-bind": "ro", "--tmpfs": "tmpfs", "--symlink": "link"}


class SandboxView:
    """Which part of the sandbox a path falls in, from the plan's mounts."""

    def __init__(self, plan, home):
        self.mounts = {"/": "root", "/proc": "system", "/dev": "system"}
        for dest, _, args in plan.mounts:
            kind = MOUNT_KINDS.get(args[0])
            if kind == "tmpfs":
                kind = "home" if dest == home else "system"
            if kind:
                self.mounts[dest] = kind
        self.hidden, self.deny_globs = list(plan.hidden), list(plan.deny_globs)
        self.home, self.project = home, plan.project
        self.path_dirs = {os.path.normpath(p) for p in plan.env.get("PATH", "").split(":")
                          if os.path.isabs(p)}

    def kind(self, path):
        best = max((dest for dest in self.mounts if is_within(path, dest)), key=len)
        return self.mounts[best]

    def is_lookup(self, path):
        """A search through PATH, or upward from the project (node_modules, config files)."""
        parent = os.path.dirname(path)
        if parent in self.path_dirs:
            return True
        return bool(self.project) and parent != self.home and parent != self.project \
            and is_within(self.project, parent) and is_within(parent, self.home)

    def reason(self, path, error, writes):
        """Why the sandbox refused this access, or None if the sandbox didn't cause it."""
        if error not in FILE_ERRORS or not path.startswith("/") or len(path) > FILE_PATH_MAX:
            return None
        path = "/" + os.path.normpath(path).lstrip("/")
        if any(is_within(path, p) for p in SYSTEM_FORBIDDEN):
            return None
        # Never suggest mounting a secret: denied and sensitive paths are reported as deliberate.
        if any(is_within(path, h) for h in self.hidden) or is_sensitive(path, self.deny_globs):
            return HIDDEN
        kind = self.kind(path)
        if kind == "ro" and (error == "EROFS" or (writes and error in ("EACCES", "EPERM"))):
            return READ_ONLY
        if kind in ("root", "home"):
            if any(is_within(path, p) for p in IGNORED_PROBES) or self.is_lookup(path):
                return None
            return NOT_MOUNTED
        return None


def notice_text(path):
    """One line of plain text: no tabs, newlines or terminal escapes."""
    return "".join(c if c.isprintable() else f"\\x{ord(c):02x}" for c in path)


def file_group(path, home):
    """The top-level directory a path is counted under: ~/.npm, /etc, /opt."""
    if is_within(path, home) and path != home:
        return os.path.join(home, os.path.relpath(path, home).split("/")[0])
    return "/" + path.lstrip("/").split("/")[0]


class BlockedFiles:
    """The paths refused this session, one "path<TAB>reason" line each, for the agent. Like
    proxy.BlockedList: bind-mounted, so appended to and never replaced.

    Agents look up hundreds of optional files at start-up (~/.npm, ~/.claude/...), so each
    top-level directory gets at most BLOCKED_GROUP_LIMIT lines, then one "dir/*" line: a
    noisy tool can't push out the path the agent needs later."""

    def __init__(self, path, home="/nonexistent"):
        self.path, self.home = path, home
        self.seen = set()
        self.groups = {}
        self.truncated = False

    def add(self, path, reason):
        """Returns True the first time a path is listed."""
        if self.path is None or path in self.seen or self.truncated:
            return False
        group = file_group(path, self.home)
        count = self.groups.get(group, 0)
        if count > BLOCKED_GROUP_LIMIT:
            return False
        self.groups[group] = count + 1
        if len(self.seen) >= BLOCKED_FILES_LIMIT:
            self.truncated = True
            line = "list truncated: the user can see more with pithos report\n"
        elif count == BLOCKED_GROUP_LIMIT:
            line = f"{notice_text(group)}/*\tmore paths here, not listed\n"
        else:
            self.seen.add(path)
            line = f"{notice_text(path)}\t{reason}\n"
        try:
            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            try:
                os.write(fd, line.encode("utf-8"))
            finally:
                os.close(fd)
        except OSError:
            pass
        return path in self.seen


class TraceWatcher:
    """Reads strace's output from a FIFO while the sandbox runs: copies it to the --trace log
    if there is one, and lists refused accesses for the agent and the session log."""

    def __init__(self, fifo, view, denied, log=None, copy_path=None):
        self.fifo, self.view, self.denied, self.log = fifo, view, denied, log
        self.copy_path = copy_path
        self.logged = set()
        self.thread = None

    def start(self):
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def finish(self, timeout=5):
        """Wait for strace to close the FIFO; unblock the reader if strace never opened it."""
        if self.thread is None:
            return
        self.thread.join(timeout)
        if self.thread.is_alive():
            with contextlib.suppress(OSError):
                os.close(os.open(self.fifo, os.O_WRONLY | os.O_NONBLOCK))
            self.thread.join(timeout)
        self.thread = None

    def _run(self):
        try:
            with open(self.fifo, "rb") as f:
                copy = open(self.copy_path, "ab") if self.copy_path else contextlib.nullcontext()
                with copy:
                    for text in sandbox_calls(self._lines(f, copy if self.copy_path else None)):
                        self.check(text)
        except Exception as e:  # never take the session down: only the notice is lost
            note(f"file notice stopped: {clean(type(e).__name__)}")

    @staticmethod
    def _lines(f, copy):
        """Lines of at most TRACE_LINE_MAX bytes; the rest of a longer line is dropped."""
        whole = True
        while raw := f.readline(TRACE_LINE_MAX):
            if copy:
                copy.write(raw)
            ends = raw.endswith(b"\n")
            if whole and ends:
                yield raw.decode("ascii", "backslashreplace")
            whole = ends

    def check(self, text):
        if " = -1 E" not in text:
            return
        parsed = parse_trace_call(text)
        if not parsed or not parsed[2]:
            return
        _, found, error, writes = parsed
        for path in found:
            reason = self.view.reason(path, error, writes)
            if not reason:
                continue
            path = "/" + os.path.normpath(path).lstrip("/")
            self.denied.add(path, reason)
            if self.log and path not in self.logged and len(self.logged) < FILE_EVENTS_LIMIT:
                self.logged.add(path)
                self.log(action="file", path=path, reason=reason, error=error)


# -- ssh agent (optional) --------------------------------------------------------------

def start_ssh_agent(cfg, project, paths, runtime, plan):
    ssh = cfg.get("ssh", {})
    if "key" not in ssh:
        return None
    key = expand_path(ssh["key"], project, paths)
    known = expand_path(ssh.get("known_hosts", "~/.ssh/known_hosts"), project, paths)
    sock = os.path.join(runtime, "ssh-agent.sock")
    # -P none: the sandbox may only use this key, never make the agent load PKCS#11/FIDO
    # providers on the host.
    out = subprocess.run(["ssh-agent", "-s", "-P", "none", "-a", sock], check=True,
                         capture_output=True, text=True).stdout
    match = re.search(r"SSH_AGENT_PID=(\d+)", out)
    if not match:
        raise ConfigError("could not start ssh-agent")
    agent_pid = int(match.group(1))
    agent_env = {**os.environ, "SSH_AUTH_SOCK": sock}
    if subprocess.run(["ssh-add", key], env=agent_env).returncode != 0:
        os.kill(agent_pid, signal.SIGTERM)
        raise ConfigError(f"ssh-add {key} failed")
    shutil.copyfile(known, os.path.join(runtime, "known_hosts"))
    plan.mount(SANDBOX_RUN + "/ssh-agent.sock", 1,
               ["--bind", sock, SANDBOX_RUN + "/ssh-agent.sock"])
    plan.mount(SANDBOX_RUN + "/known_hosts", 2,
               ["--ro-bind", os.path.join(runtime, "known_hosts"), SANDBOX_RUN + "/known_hosts"])
    if os.path.exists("/etc/ssh/ssh_config"):
        plan.mount("/etc/ssh/ssh_config", 2,
                   ["--ro-bind", "/etc/ssh/ssh_config", "/etc/ssh/ssh_config"])
    proxy_cmd = f"{SANDBOX_PYTHON} -I {SANDBOX_RUN}/bridge.py connect %h %p"
    plan.env["SSH_AUTH_SOCK"] = SANDBOX_RUN + "/ssh-agent.sock"
    plan.env["GIT_SSH_COMMAND"] = shlex.join([
        "ssh", "-o", f"ProxyCommand={proxy_cmd}", "-o", "StrictHostKeyChecking=yes",
        "-o", f"UserKnownHostsFile={SANDBOX_RUN}/known_hosts"])
    return agent_pid


# -- commands --------------------------------------------------------------------------

def make_runtime_dir():
    """Private host-side dir for the proxy socket. Kept short: UNIX socket paths max out at
    107 bytes. Never visible in the sandbox, which gets its own /run and /tmp."""
    xdg = os.environ.get("XDG_RUNTIME_DIR", "")
    base = xdg if os.path.isabs(xdg) and os.path.isdir(xdg) else tempfile.gettempdir()
    runtime = tempfile.mkdtemp(prefix="pithos-", dir=base)  # mode 0700
    if len(os.path.join(runtime, "ssh-agent.sock")) > 100:
        shutil.rmtree(runtime)
        raise ConfigError(f"runtime dir path too long for a UNIX socket: {runtime}")
    return runtime


def resolve_project(value):
    return os.path.realpath(value or os.getcwd())


def drop_base_hosts(cfg, paths, command):
    """Leave the agent only its own hosts: a report analyst has no use for code hosts."""
    base = set(load_profile(paths, "base").get("net", {}).get("allow", []))
    keep = EXPLAIN_OPENCODE_HOSTS if command == "opencode" else ()
    net = cfg.setdefault("net", {})
    net["allow"] = [h for h in net.get("allow", []) if h not in base or h in keep]


def cmd_run(args, paths):
    project = resolve_project(args.project)
    check_project(project, paths)
    cmd = args.cmd[1:] if args.cmd[:1] == ["--"] else args.cmd
    profile = args.profile
    if profile is None:
        guess = os.path.basename(cmd[0]) if cmd else ""
        profile = guess if PROFILE_NAME.match(guess) and os.path.exists(
            os.path.join(paths.config, guess + ".toml")) else "base"
    if not cmd:
        cmd = [profile] if profile != "base" else ["/bin/bash"]
    cfg = merge(load_profile(paths, profile), load_project(paths, project))
    if args.no_base_net:
        drop_base_hosts(cfg, paths, os.path.basename(cmd[0]))
    try:
        allowlist = proxy.Allowlist(cfg.get("net", {}).get("allow", []))
    except ValueError as e:
        raise ConfigError(f"net.allow: {e}")

    bwrap = os.environ.get("PITHOS_BWRAP") or shutil.which("bwrap")
    if not bwrap:
        raise ConfigError("bubblewrap not found: sudo apt install bubblewrap")
    check_bwrap(bwrap)
    file_notice = not args.no_file_notice and cfg.get("agent", {}).get("file_notice", True)
    strace = shutil.which("strace") if args.trace or file_notice else None
    if args.trace and not strace:
        raise ConfigError("--trace needs strace: sudo apt install strace")
    if file_notice and not strace:
        note("strace not found: the agent won't be told which file accesses the sandbox refused "
             "(sudo apt install strace, or --no-file-notice)")
        file_notice = False
    if strace and not ptrace_allowed():
        if args.trace:
            raise ConfigError("--trace needs ptrace: kernel.yama.ptrace_scope is 2 or more")
        note("ptrace is restricted (kernel.yama.ptrace_scope): no file notice for the agent")
        strace, file_notice = None, False
    if not os.path.exists(SANDBOX_PYTHON):
        raise ConfigError(f"{SANDBOX_PYTHON} is needed inside the sandbox")

    limits, warnings = resolve_limits(cfg, read_machine())
    for warning in warnings:
        note(f"WARNING: {warning}")
    systemd_run = None
    if args.no_limits:
        note("--no-limits: no limit on the sandbox's total memory or CPU; processes, memory per "
             "process and tmpfs sizes are still limited")
    else:
        systemd_run = find_systemd_run()
        why = check_scope(systemd_run) if not args.dry_run else (
            None if systemd_run else "systemd-run is not installed")
        if why:
            raise ConfigError(f"can't put the sandbox in a systemd scope to limit its memory and "
                              f"processes: {why}.\nRun pithos from a login session, or pass "
                              f"--no-limits to run without those limits")

    os.makedirs(paths.logs, mode=0o700, exist_ok=True)
    runtime = make_runtime_dir()
    server = agent_pid = session = watcher = monitor = None
    try:
        notice = (AGENT_NOTICE + (FILE_NOTICE if file_notice else "")
                  + limits_notice(limits, scoped=bool(systemd_run)))
        write_runtime_files(runtime, notice)
        plan = build_plan(cfg, project, paths, runtime, limits=limits)
        plan.scoped = bool(systemd_run)
        plan.notice_text = notice
        if args.verbose or args.dry_run:
            note(f"limits: {describe_limits(limits)}")
        if args.verbose:
            for line in plan.skipped:
                note(f"skipped {line}")
        fifo = os.path.join(runtime, "trace.fifo")
        if args.dry_run:
            argv = bwrap_argv(bwrap, plan, project, agent_command(cfg, cmd))
            if strace:
                argv = strace_argv(strace, fifo, argv, failed_only=not args.trace)
            if systemd_run:
                argv = scope_argv(systemd_run, "pithos-<session>.scope", limits) + argv
            print(shlex.join(argv))
            return 0
        make_dirs(plan)
        session = time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3)
        log_path = os.path.join(paths.logs, session + ".jsonl")
        register_session(paths, session, project)
        live = proxy.LiveAllowlist(allowlist, [paths.session_file(session), paths.allowed],
                                   lambda: read_live_entries(paths, session, project))
        server = proxy.ProxyServer(live, log_path=log_path,
                                   blocked_path=os.path.join(runtime, "blocked-hosts"))
        live.log = server.log
        server.log(action="start", profile=profile, project=project, cmd=cmd,
                   data_home=plan.env.get("XDG_DATA_HOME"), rules=rule_snapshot(cfg),
                   limits=limits, scoped=bool(systemd_run))
        live.refresh()
        for problem in live.problems:
            note(f"WARNING: {clean(problem)}")
        if live.entries:
            note(f"hosts saved for this project: {clean(' '.join(live.entries))}")
        server.start(os.path.join(runtime, "proxy.sock"))
        agent_pid = start_ssh_agent(cfg, project, paths, runtime, plan)
        env_r, env_w = os.pipe()
        data = b"".join(a.encode() + b"\0" for a in env_args(plan))
        if len(data) > 60000:  # must fit the pipe buffer: we write before bwrap reads
            raise ConfigError("sandbox environment too large")
        os.write(env_w, data)
        os.close(env_w)
        argv = bwrap_argv(bwrap, plan, project, agent_command(cfg, cmd), env_fd=env_r)
        trace_path = None
        if strace:
            if args.trace:
                trace_path = os.path.join(paths.logs, session + ".trace")
                create_trace_log(trace_path)
            os.mkfifo(fifo, 0o600)
            denied = BlockedFiles(os.path.join(runtime, "blocked-files") if file_notice else None,
                                  paths.home)
            watcher = TraceWatcher(fifo, SandboxView(plan, paths.home), denied,
                                   server.log if file_notice else None, trace_path)
            watcher.start()
            argv = strace_argv(strace, fifo, argv, failed_only=not args.trace)
        unit = f"pithos-{session}.scope"
        if systemd_run:
            argv = scope_argv(systemd_run, unit, limits) + argv

        # Keep the launcher alive on ^C/SIGTERM (handlers, unlike SIG_IGN, reset on exec);
        # bwrap's --die-with-parent takes the sandbox down if we are killed anyway.
        child = None

        def forward(signum, _frame):
            if child and signum == signal.SIGTERM:
                child.send_signal(signum)

        signal.signal(signal.SIGINT, forward)
        signal.signal(signal.SIGTERM, forward)
        signal.signal(signal.SIGHUP, forward)
        set_window_title(os.path.basename(cmd[0]))
        child = subprocess.Popen(argv, pass_fds=(env_r,))
        os.close(env_r)
        events = LimitEvents(os.path.join(runtime, "limit-events"), limits, server.log)
        if systemd_run:
            cgroup = scope_cgroup(child.pid, unit)
            if cgroup:
                monitor = ScopeMonitor(cgroup, events)
                monitor.start()
            else:
                note("WARNING: can't find the sandbox's scope: limits apply, but the agent won't "
                     "be told when one is hit")
        code = child.wait()
        if monitor:
            monitor.stop()
        if events.totals.get("memory"):
            note(f"the kernel killed {events.totals['memory']} process(es) in the sandbox: it "
                 f"reached its memory limit ({describe_amount('total', limits['total'])}); "
                 f"see pithos report")
        if events.totals.get("processes"):
            note(f"{events.totals['processes']} process start(s) refused: the sandbox reached its "
                 f"limit of {limits['processes']} processes; see pithos report")
        if watcher:
            watcher.finish()
        server.log(action="exit", code=code)
        if trace_path:
            note(f"trace: {clean(trace_path)} (pithos report, or pithos log --files)")
        for path in quarantine(plan, session):
            server.log(action="quarantine", path=path)
            note(f"WARNING: the sandbox created a protected path; moved to {clean(path)}")
        return code if code >= 0 else 128 - code
    finally:
        if monitor:
            monitor.stop()
        if watcher:
            watcher.finish(timeout=1)
        if server:
            server.stop()
        if session:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(paths.session_file(session))
        if agent_pid:
            try:
                os.kill(agent_pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        shutil.rmtree(runtime, ignore_errors=True)


def cmd_trust(args, paths):
    project = resolve_project(args.project)
    check_project(project, paths)
    raw, digest = read_project_file(project)
    if raw is None:
        raise ConfigError(f"{project} has no {PROJECT_FILE}")
    data = parse_project_file(project, raw)
    print(f"--- {project}/{PROJECT_FILE}")
    print(clean(raw.decode("utf-8")))
    print("--- adds:")
    for section, keys in data.items():
        for key, value in keys.items():
            print(f"  {section}.{key}: {clean(json.dumps(value))}")
    if not args.yes:
        if not sys.stdin.isatty():
            raise ConfigError("not a terminal: pass --yes to trust non-interactively")
        if input("Trust this file? [y/N] ").strip().lower() != "y":
            return 1
    trusted = read_trusted(paths)
    trusted[project] = digest
    os.makedirs(paths.state, mode=0o700, exist_ok=True)
    write_private_json(paths.trusted, trusted)
    print(f"trusted {project}/{PROJECT_FILE}")
    return 0


def allow_list(paths, sessions, project):
    for session, record in sessions.items():
        print(clean(f"session {session}: {json.dumps(record.get('allow', []))}"))
    if not sessions:
        print("no running session in this project")
    saved = (read_json_table(paths.allowed) or {}).get(project, [])
    print(clean(f"saved for this project: {json.dumps(saved)}"))
    return 0


def allow_remove(paths, sessions, project, raw):
    removed = set()

    def change(old):
        kept = [e for e in old if not any(same_entry(e, r) for r in raw)]
        removed.update(e for e in old if e not in kept)
        return kept

    update_entries(paths, sessions, project, change, save=True)
    if not removed:
        raise ConfigError(f"not approved with `pithos allow`: {' '.join(raw)} "
                          "(hosts in a profile or .pithos.toml are removed there)")
    print(clean(f"removed {' '.join(sorted(removed))}; connections already open stay open"))
    return 0


def allow_prompt(paths, sessions, project):
    pending = pending_hosts(paths, sessions, project)
    if not pending:
        print("no denied hosts are waiting")
        return 0
    interactive = sys.stdin.isatty()
    for entry, count in pending[:PENDING_SHOWN]:
        line = clean(f"{entry} ({count}x)")
        if not interactive:
            print(line)
            continue
        try:
            answer = input(f"{line} allow? [y]es / [s]ave / [N]o ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
        if answer in ("y", "s"):
            add_entries(paths, sessions, project, [entry], save=answer == "s")
    if len(pending) > PENDING_SHOWN:
        print(f"and {len(pending) - PENDING_SHOWN} more: see pithos log --denied")
    if not interactive:
        print("not a terminal, nothing approved: run pithos allow HOST[:PORT]")
    return 0


def cmd_allow(args, paths):
    if os.environ.get("PITHOS"):
        raise ConfigError("pithos allow must run outside the sandbox, in another terminal")
    if args.save + args.remove + args.list > 1:
        raise ConfigError("use only one of --save, --remove and --list")
    if args.list and args.hosts:
        raise ConfigError("--list takes no hosts")
    if (args.save or args.remove) and not args.hosts:
        raise ConfigError("--save and --remove need at least one host")
    project = resolve_project(args.project)
    check_project(project, paths)
    running = running_sessions(paths)
    sessions = {k: v for k, v in running.items() if v["project"] == project}
    if args.list:
        return allow_list(paths, sessions, project)
    if args.remove:
        return allow_remove(paths, sessions, project, args.hosts)
    if not sessions and not args.save:
        others = sorted({v["project"] for v in running.values()})
        raise ConfigError(f"no running session in {project}. Use -C PROJECT or --save. "
                          f"Running in: {', '.join(others) or 'nothing'}")
    if not args.hosts:
        return allow_prompt(paths, sessions, project)
    entries = []
    for raw in args.hosts:
        try:
            entries.append(proxy.check_live_entry(raw))
        except ValueError as e:
            raise ConfigError(f"{raw}: {e}")
    add_entries(paths, sessions, project, list(dict.fromkeys(entries)), args.save)
    return 0


def sum_traces(files):
    totals = {name: {} for name in TRACE_GROUPS}
    for path in files:
        with open(path, encoding="ascii", errors="replace") as f:
            for name, counts in summarise_trace(f).items():
                for item, count in counts.items():
                    totals[name][item] = totals[name].get(item, 0) + count
    return totals


def print_trace_summary(args, paths):
