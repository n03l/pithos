def set_window_title(name, stream=None):
    """Inside tmux, name the window after the agent (needs `allow-rename on`)."""
    if not os.environ.get("TMUX"):
        return
    stream = stream or sys.stderr
    if not stream.isatty():
        return
    title = "".join(c for c in str(name) if c.isprintable())
    if not title:
        return
    stream.write(f"\033]2;{title}\007")
    stream.flush()


# -- hosts approved during a session ---------------------------------------------------
# Kept in the state dir, which the sandbox never sees. Session files last as long as their
# launcher; allowed.json maps a project to the hosts saved for all its sessions.

def read_live_entries(paths, session, project):
    """{source file: its entries for this session, or None if unusable}, for LiveAllowlist."""
    session_path = paths.session_file(session)
    record, saved = read_json_table(session_path), read_json_table(paths.allowed)
    return {session_path: None if record is None else record.get("allow", []),
            paths.allowed: None if saved is None else saved.get(project, [])}


def register_session(paths, session, project):
    os.makedirs(paths.sessions, mode=0o700, exist_ok=True)
    write_private_json(paths.session_file(session),
                       {"pid": os.getpid(), "project": project, "allow": []})


def running_sessions(paths):
    """{session: record} for live launchers. Files left by dead launchers are removed. A reused
    pid only keeps a stale file around: no proxy reads it."""
    sessions = {}
    for path in sorted(glob.glob(os.path.join(glob.escape(paths.sessions), "*.json"))):
        record = read_json_table(path)
        if not record or type(record.get("pid")) is not int or record["pid"] <= 0 \
                or not isinstance(record.get("project"), str):
            continue
        try:
            os.kill(record["pid"], 0)
        except (ProcessLookupError, OverflowError):
            remove_file(path)
            continue
        except PermissionError:
            pass
        sessions[os.path.basename(path)[: -len(".json")]] = record
    return sessions


@contextlib.contextmanager
def allow_lock(paths):
    os.makedirs(paths.sessions, mode=0o700, exist_ok=True)
    with open(os.open(os.path.join(paths.state, "allow.lock"), os.O_WRONLY | os.O_CREAT, 0o600),
              "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def entry_list(values, path):
    if not isinstance(values, list) or not all(isinstance(v, str) for v in values):
        raise ConfigError(f"{path} is damaged: fix or delete it")
    return values


def same_entry(a, b):
    """Compare canonically, falling back to the raw text for entries that no longer validate."""
    def canon(entry):
        try:
            return proxy.check_live_entry(entry)
        except ValueError:
            return entry
    return canon(a) == canon(b)


def update_entries(paths, sessions, project, change, save):
    """Apply change(list) -> list to each session file and, with save, the project's saved list.
    Every file is checked before any is written: a damaged one changes nothing anywhere."""
    with allow_lock(paths):
        records = {}
        for session in sessions:
            path = paths.session_file(session)
            record = read_json_table(path)
            if record == {}:
                continue  # the session ended a moment ago
            entry_list(None if record is None else record.get("allow", []), path)
            records[path] = record
        if save:
            table = read_json_table(paths.allowed)
            entry_list(None if table is None else table.get(project, []), paths.allowed)
        for path, record in records.items():
            write_private_json(path, {**record, "allow": change(record.get("allow", []))})
        if save:
            kept = change(table.get(project, []))
            table = {k: v for k, v in table.items() if k != project}
            write_private_json(paths.allowed, {**table, project: kept} if kept else table)


def add_entries(paths, sessions, project, entries, save):
    update_entries(paths, sessions, project,
                   lambda old: list(dict.fromkeys(old + entries)), save)
    where = f"{len(sessions)} running session(s)"
    for entry in entries:
        print(clean(f"allowed {entry} in {where}" + ("; saved for this project" if save else "")))


def known_entries(paths, sessions, project):
    """Allowlist of the valid entries already approved for these sessions."""
    table = read_json_table(paths.allowed) or {}
    values = list(table.get(project, [])) if isinstance(table.get(project), list) else []
    for record in sessions.values():
        if isinstance(record.get("allow"), list):
            values += record["allow"]
    known = []
    for value in values:
        with contextlib.suppress(ValueError):
            known.append(proxy.check_live_entry(value))
    return proxy.Allowlist(known)


def pending_hosts(paths, sessions, project):
    """[(entry, count)] for hosts refused only for not being listed, most denied first. The
    sandbox picks these names, so only well-formed host names are offered: IPs and wildcards
    need an explicit `pithos allow HOST`."""
    known = known_entries(paths, sessions, project)
    counts = {}
    for session in sessions:
        try:
            for event in read_session(os.path.join(paths.logs, session + ".jsonl")):
                offer = offerable_host(event)
                if offer and not known.allows("name", *offer):
                    key = proxy.live_entry(*offer)
                    counts[key] = counts.get(key, 0) + event_weight(event)
        except OSError:
            continue
    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))


# -- sandbox plan ----------------------------------------------------------------------

RUN_TMPFS_SIZE = 64 << 20  # /run only holds pithos's own files and a few sockets


class Plan:
    """What build_plan decided: bwrap's mounts and environment, and what to do on the host
    before and after the session."""

    def __init__(self):
        self.runtime = None  # private host dir with the files bound into the sandbox
        self.mounts = []  # (dest, order, [bwrap args])
        self.overlays = []  # [bwrap args], applied after every bind
        self.env = {}
        self.skipped = []
        self.mkdirs = []  # host directories to create before starting bwrap
        self.copies = []  # (host file, private copy) made before starting bwrap
        self.notices = []  # (host file, generated file): host file + notice_text
        self.notice_text = AGENT_NOTICE
        self.watch = []  # ro_in_project paths missing at start: checked again after exit
        self.project = None
        self.gitdirs = []  # submodule git dirs found at start
        self.hidden = []  # plain deny paths and the paths deny overlays cover
        self.deny_globs = []
        self.tmpfs = {}  # writable tmpfs in the sandbox: its size, or None if unlimited
        self.limits = None
        self.scoped = True  # limits.total, processes and cpu are enforced by a systemd scope
        self.publish = None  # (host address, port) from --publish
        self.bind_sources = []  # host paths of the profile's binds: mounted by fd (open_binds)

    def mount(self, dest, order, args):
        self.mounts.append((dest, order, args))


def submodule_gitdirs(project):
    """Return (git dirs, links) under .git/modules, relative to the project. A git dir is a
    directory holding HEAD; nested submodules live in its own modules/ subdirectory."""
    gitdirs, links, todo, seen = [], [], [SUBMODULES], 0
    while todo:
        rel = todo.pop()
        path = os.path.join(project, rel)
        seen += 1
        if seen > SUBMODULE_SCAN_LIMIT:
            raise ConfigError(f"too many directories under {clean(project)}/{SUBMODULES}")
        if os.path.islink(path):
            links.append(rel)
        elif not os.path.isdir(path):
            continue
        elif os.path.isfile(os.path.join(path, "HEAD")):
            gitdirs.append(rel)
            todo.append(rel + "/modules")
        else:
            todo += [f"{rel}/{name}" for name in sorted(os.listdir(path))]
    return sorted(gitdirs), sorted(links)


def enclosing_mode(path, binds):
    """Mode of the deepest bind showing path in the sandbox ("ro" wins a tie, as in
    bwrap_argv's order), or None if no bind does."""
    best = max(((len(dest), mode != "rw", mode) for mode, _, dest in binds
                if is_within(path, dest)), default=None)
    return best and best[2]


def build_plan(cfg, project, paths, runtime, environ=None, limits=None, scoped=True,
               notice=AGENT_NOTICE):
    environ = os.environ if environ is None else environ
    fs, env_cfg = cfg.get("fs", {}), cfg.get("env", {})
    plan = Plan()
    plan.runtime, plan.limits, plan.scoped, plan.notice_text = runtime, limits, scoped, notice

    deny_plain = [expand_path(d, project, paths) for d in fs.get("deny", []) if not has_glob(d)]
    deny_globs = [expand_glob(d, project, paths) for d in fs.get("deny", []) if has_glob(d)]
    # Plain deny paths also forbid binding anything inside them (e.g. ro = ["~/.ssh/id_rsa"]).
    denied_roots = [os.path.realpath(d) for d in deny_plain]

    binds = []  # (mode, src, dest)
    for key in ("rw", "rw_mkdir", "ro"):
        mode = "ro" if key == "ro" else "rw"
        for value in fs.get(key, []):
            dest = expand_path(value, project, paths)
            src = os.path.realpath(dest)
            check_bind(mode, src, dest, paths, denied_roots)
            if key == "rw_mkdir":
                if os.path.lexists(src) and not os.path.isdir(src):
                    raise ConfigError(f"fs.rw_mkdir: {dest} exists and is not a directory")
                if not os.path.lexists(src):
                    plan.mkdirs.append(src)
            elif not os.path.lexists(dest):
                plan.skipped.append(f"{mode} {dest} (missing)")
                continue
            binds.append((mode, src, dest))
    # Writable private copies: the sandbox may change them, nothing it writes persists.
    for n, value in enumerate(fs.get("copy", [])):
        dest = expand_path(value, project, paths)
        src = os.path.realpath(dest)
        check_bind("rw", src, dest, paths, denied_roots)
        if not os.path.lexists(dest):
            plan.skipped.append(f"copy {dest} (missing)")
            continue
        if not os.path.isfile(src):
            raise ConfigError(f"fs.copy: {dest} is not a regular file")
        copy = os.path.join(runtime, f"copy-{n}")
        plan.copies.append((src, copy))
        plan.mount(dest, 1, ["--bind", copy, dest])
        binds.append(("copy", src, dest))
    plan.project = project
    plan.gitdirs, links = submodule_gitdirs(project)
    if links:
        raise ConfigError(f"{clean(project)}/{links[0]} is a link: can't protect submodule hooks")
    submodule_files = [f"{g}/{name}" for g in plan.gitdirs for name in GITDIR_FILES]
    profile_binds = list(binds)
    for rel in ALWAYS_RO_IN_PROJECT + fs.get("ro_in_project", []) + submodule_files:
        if os.path.isabs(rel) or ".." in rel.split("/"):
            raise ConfigError(f"fs.ro_in_project entries must be relative: {clean(rel)!r}")
        dest = os.path.normpath(os.path.join(project, rel))
        if enclosing_mode(dest, profile_binds) != "rw":
            continue  # read-only already, or not in the sandbox: pinning would make it writable
        if not os.path.lexists(dest):
            plan.skipped.append(f"ro_in_project {dest} (missing)")
            plan.watch.append(dest)
            continue
        src = os.path.realpath(dest)
        if not is_within(src, project):
            raise ConfigError(f"{dest} links outside the project ({src})")
        # Pin every ancestor (.git, .claude) as a mount point: otherwise the sandbox can
        # rename it away (mv .git .git.x) and recreate the protected file writable.
        anc = os.path.dirname(dest)
        while anc != project:
            if os.path.islink(anc):
                raise ConfigError(f"{anc} is a link: can't protect {dest} inside it")
            binds.append(("rw", anc, anc))
            anc = os.path.dirname(anc)
        binds.append(("ro", src, dest))

    if "notice_into" in cfg.get("agent", {}):
        dest = expand_path(cfg["agent"]["notice_into"], project, paths)
        src = os.path.realpath(dest)
        check_bind("ro", src, dest, paths, denied_roots)
        if os.path.lexists(src) and not os.path.isfile(src):
            raise ConfigError(f"agent.notice_into: {dest} is not a regular file")
        notice = os.path.join(runtime, "agent-notice.md")
        plan.notices.append((src, notice))
        plan.mount(dest, 3, ["--ro-bind", notice, dest])  # over the fs.ro bind of the same file

    for mode, src, dest in dict.fromkeys(binds):
        if mode == "copy":
            continue
        check_bind(mode, src, dest, paths, denied_roots)
        flag = "--bind" if mode == "rw" else "--ro-bind"
        plan.mount(dest, 1 if mode == "rw" else 2, [flag, src, dest])
        plan.bind_sources.append(src)

    # Every writable tmpfs is sized: they are RAM. / and /dev are made read-only at the end of
    # bwrap's argv (bwrap_argv), so these and the binds are the only places to write.
    size = ["--size", str(limits["tmpfs"])] if limits and limits.get("tmpfs") else []
    for dest in (paths.home, "/tmp", "/var/tmp", "/dev/shm"):
        plan.mount(dest, 0, [*size, "--tmpfs", dest])
        plan.tmpfs[dest] = limits["tmpfs"] if size else None
    plan.mount("/run", 0, ["--size", str(RUN_TMPFS_SIZE), "--tmpfs", "/run"])
    plan.tmpfs["/run"] = RUN_TMPFS_SIZE
    plan.mount(SANDBOX_RUN + "/proxy.sock", 1,
               ["--bind", os.path.join(runtime, "proxy.sock"), SANDBOX_RUN + "/proxy.sock"])
    plan.mount(SANDBOX_RUN + "/bridge.py", 2,
               ["--ro-bind", os.path.join(HERE, "bridge.py"), SANDBOX_RUN + "/bridge.py"])
    runtime_files = {"blocked-hosts": SANDBOX_BLOCKED_HOSTS, "blocked-files": SANDBOX_BLOCKED_FILES,
                     "limit-events": SANDBOX_LIMIT_EVENTS, "notice.md": SANDBOX_NOTICE,
                     "opencode.json": SANDBOX_OPENCODE_CONFIG}
    if cfg.get("agent", {}).get("connect_claude_agent"):
        runtime_files["claude-agent.json"] = SANDBOX_CLAUDE_AGENT
    for name, dest in runtime_files.items():
        plan.mount(dest, 2, ["--ro-bind", os.path.join(runtime, name), dest])
    usr_bound = any(dest == "/usr" for _, _, dest in binds)
    for link in SYSTEM_SYMLINKS:
        if usr_bound and os.path.islink(link):
            plan.mount(link, 0, ["--symlink", os.readlink(link), link])

    # Deny overlays: hide matches that would otherwise be visible through a bind.
    visible = [dest for _, _, dest in binds]
    empty = os.path.join(runtime, "empty")
    matches = deny_plain + [paths.state]
    for pattern in deny_globs:
        matches += glob.glob(pattern, recursive=True, include_hidden=True)
    hidden = []
    for match in dict.fromkeys(matches):
        if not os.path.lexists(match):
            continue
        # A denied symlink (~/.ssh -> dotfiles/ssh) hides its target wherever a bind shows it.
        real = os.path.realpath(match)
        targets = [] if os.path.islink(match) else [match]
        targets += [os.path.join(dest, os.path.relpath(real, src)) for _, src, dest in binds
                    if is_within(real, src)]
        for target in dict.fromkeys(os.path.normpath(t) for t in targets):
            if target in hidden or not any(is_within(target, v) for v in visible):
                continue
            hidden.append(target)
            if os.path.isdir(real):
                plan.overlays += [["--tmpfs", target], ["--remount-ro", target]]
            else:
                plan.overlays.append(["--ro-bind", empty, target])
    plan.hidden = list(dict.fromkeys(deny_plain + hidden))
    plan.deny_globs = deny_globs

    env = {
        "HOME": paths.home,
        "USER": environ.get("USER", "agent"),
        "LOGNAME": environ.get("USER", "agent"),
        "SHELL": "/bin/bash",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "PITHOS": "1",
    }
    for name in env_cfg.get("pass", []):
        if not ENV_NAME.match(name):
            raise ConfigError(f"invalid env.pass name {clean(name)!r}")
        if name in environ:
            env[name] = environ[name]
    for name, value in env_cfg.get("set", {}).items():
        if not ENV_NAME.match(name):
            raise ConfigError(f"invalid env.set name {clean(name)!r}")
        env[name] = ":".join(expand(part, project, paths) for part in value.split(":"))
    for name in ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy"):
        env[name] = PROXY_URL
    env.update(NO_PROXY=NO_PROXY, no_proxy=NO_PROXY, NODE_USE_ENV_PROXY="1",
               PITHOS_BLOCKED_HOSTS=SANDBOX_BLOCKED_HOSTS, PITHOS_BLOCKED_FILES=SANDBOX_BLOCKED_FILES,
               PITHOS_LIMIT_EVENTS=SANDBOX_LIMIT_EVENTS)
    for name in ("ALL_PROXY", "all_proxy"):
        env.pop(name, None)
    if cfg.get("agent", {}).get("connect_claude_agent") and "XDG_DATA_HOME" not in env:
        raise ConfigError("agent.connect_claude_agent: needs XDG_DATA_HOME in env.set")
    if any("\0" in v for v in env.values()):
        raise ConfigError("environment values must not contain NUL")
    plan.env = env
    return plan


def add_publish(plan, spec):
    """Bind publish.sock (made by PublishServer in the runtime dir) alone, read-only: connect()
    works through it, and the sandbox can't replace it."""
    plan.publish = spec
    plan.mount(SANDBOX_PUBLISH_SOCK, 2,
               ["--ro-bind", os.path.join(plan.runtime, "publish.sock"), SANDBOX_PUBLISH_SOCK])


def make_dirs(plan):
    for path in plan.mkdirs:
        os.makedirs(path, mode=0o700, exist_ok=True)
        if os.path.realpath(path) != path:
            raise ConfigError(f"{path} changed into a link while being created")
    for src, copy in plan.copies:
        with open(src, "rb") as f, open(os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600),
                                       "wb") as out:
            shutil.copyfileobj(f, out)
    for src, target in plan.notices:
        try:
            with open(src, "rb") as f:
                text = f.read(NOTICE_SOURCE_LIMIT)
        except FileNotFoundError:
            text = b""
        write_private(target, text + b"\n" + plan.notice_text.encode())


def write_private(path, data):
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as f:
        f.write(data)


def write_runtime_files(runtime, notice=AGENT_NOTICE):
    """Files that build_plan binds into the sandbox, one by one, read-only."""
    write_private(os.path.join(runtime, "empty"), b"")
    write_private(os.path.join(runtime, "blocked-hosts"), b"")
    write_private(os.path.join(runtime, "blocked-files"), b"")
    write_private(os.path.join(runtime, "limit-events"), b"")
    write_private(os.path.join(runtime, "notice.md"), notice.encode())
    write_private(os.path.join(runtime, "opencode.json"),
                  json.dumps({"instructions": [SANDBOX_NOTICE]}).encode())
    write_private(os.path.join(runtime, "claude-agent.json"),
                  json.dumps(CLAUDE_AGENT_CREDENTIAL).encode())


def agent_command(cfg, cmd):
    """The command to run in the sandbox; cmd stays argv, never part of the script text."""
    if cfg.get("agent", {}).get("connect_claude_agent") and os.path.basename(cmd[0]) == "opencode":
        return ["sh", "-c", CONNECT_CLAUDE_AGENT, "sh", *cmd]
    return cmd


def quarantine(plan, session):
    """Move aside ro_in_project paths the sandbox created (they were missing at start), so
    host tools don't run them. Returns the paths moved."""
    planted = []
    for path in plan.watch:
        if not os.path.lexists(path):
            continue
        parent = os.path.dirname(path)
        if os.path.realpath(parent) != parent:
            note(f"WARNING: {clean(path)} appeared during the session behind a link; check it")
            continue
        planted.append(path)
    # Submodule git dirs and links that appeared under .git/modules during the session.
    git = os.path.join(plan.project, ".git") if plan.project else None
    if git and os.path.realpath(git) == git:
        try:
            gitdirs, links = submodule_gitdirs(plan.project)
        except ConfigError as e:
            note(f"WARNING: {e}; check {SUBMODULES} by hand")
            gitdirs, links = plan.gitdirs, []
        new = [os.path.join(plan.project, g, name) for g in gitdirs if g not in plan.gitdirs
               for name in GITDIR_FILES] + [os.path.join(plan.project, rel) for rel in links]
        planted += [path for path in new if os.path.lexists(path)]
    moved = []
    for path in planted:
        target = f"{path}.pithos-quarantine-{session}"
        try:
            os.rename(path, target)
        except OSError as e:
            note(f"WARNING: the sandbox created {clean(path)} and it could not be moved aside "
                 f"({e.strerror}): check it before using the project outside the sandbox")
            continue
        moved.append(target)
    return moved


def tiocsti_disabled():
    try:
        with open("/proc/sys/dev/tty/legacy_tiocsti") as f:
            return f.read().strip() == "0"
    except OSError:
        return False


def env_args(plan):
    out = []
    for name, value in sorted(plan.env.items()):
        out += ["--setenv", name, value]
    return out


def open_nofollow(path):
    """O_PATH fd for an absolute path, refusing a link in any part of it. Bind sources are
    realpaths, so a link means the path changed since build_plan: another session can write
    inside the project and swap .git/hooks for a link to ~/.ssh before bwrap mounts it."""
    fd = os.open("/", os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in [p for p in path.split("/") if p]:
            child = os.open(part, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = child
            if stat.S_ISLNK(os.fstat(fd).st_mode):
                raise ConfigError(f"{clean(path)} changed into a link while pithos was starting")
    except OSError as e:
        os.close(fd)
        raise ConfigError(f"cannot open {clean(path)}: {e.strerror}")
    except BaseException:
        os.close(fd)
        raise
    return fd


def open_binds(plan):
    """{host path: fd} for the profile's binds, for bwrap_argv. The caller closes the fds."""
    fds = {}
    try:
        for src in dict.fromkeys(plan.bind_sources):
            fds[src] = open_nofollow(src)
    except BaseException:
        close_fds(fds.values())
        raise
    return fds


def close_fds(fds):
    for fd in fds:
        with contextlib.suppress(OSError):
            os.close(fd)


def bwrap_argv(bwrap, plan, project, cmd, env_fd=None, publish_fd=None, bind_fds=None):
    """With env_fd, the environment is read from that fd (bwrap --args), so values stay out
    of the world-readable /proc/<pid>/cmdline; without it, values are shown redacted.
    publish_fd is the sandbox's end of the --publish control channel. With bind_fds (from
    open_binds), the profile's binds use --bind-fd: bwrap mounts what was opened, never a path
    looked up again."""
    bind_fds = bind_fds or {}
    argv = [bwrap, "--unshare-all", "--unshare-user", "--disable-userns", "--die-with-parent",
            "--clearenv", "--hostname", "pithos", "--proc", "/proc", "--dev", "/dev"]
    if not tiocsti_disabled():
        # Without the kernel's TIOCSTI lockdown, a sandboxed process could type into the
        # parent terminal; a new session prevents that (at the cost of job control).
        argv.append("--new-session")
    for _, _, args in sorted(plan.mounts, key=lambda m: (m[0].count("/"), m[1])):
        if args[0] in ("--bind", "--ro-bind") and args[1] in bind_fds:
            args = [args[0] + "-fd", str(bind_fds[args[1]]), args[2]]
        argv += args
    for args in plan.overlays:
        argv += args
    # bwrap's / and /dev are unsized tmpfs: read-only, they can't be used to fill RAM. Mounts
    # under them (binds, the sized tmpfs above) keep their own modes.
    argv += ["--remount-ro", "/dev", "--remount-ro", "/"]
    if env_fd is None:
        for name in sorted(plan.env):
            argv += ["--setenv", name, "<redacted>"]
    else:
        argv += ["--args", str(env_fd)]
    publish_arg = "-"
    if plan.publish:
        publish_arg = f"{plan.publish[1]}:{'<fd>' if publish_fd is None else publish_fd}"
    argv += ["--chdir", project, "--", SANDBOX_PYTHON, "-I", SANDBOX_RUN + "/bridge.py", "serve",
             SANDBOX_RUN + "/proxy.sock", str(PROXY_PORT), bridge_limits(plan.limits, plan.scoped),
             publish_arg, *cmd]
    return argv


def check_bwrap(bwrap):
    """--size sizes the tmpfs mounts; without it they would be unlimited RAM. --ro-bind-fd
    (older than --size) mounts the profile's binds. Older bubblewrap has neither, and its own
    error would be cryptic."""
    try:
        done = subprocess.run([bwrap, "--help"], capture_output=True, text=True, errors="replace",
                              timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise ConfigError(f"cannot run {clean(bwrap)}: {e}")
    if done.returncode != 0 or not all(opt in done.stdout for opt in ("--size", "--ro-bind-fd")):
        raise ConfigError(f"{clean(bwrap)} is too old: pithos needs bubblewrap 0.6 or newer, "
                          f"for the sized tmpfs mounts")


# -- ssh agent (optional) --------------------------------------------------------------

def stop_process(pid):
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)


def start_ssh_agent(cfg, project, paths, plan):
    ssh = cfg.get("ssh", {})
    if "key" not in ssh:
        return None
    key = expand_path(ssh["key"], project, paths)
    known = expand_path(ssh.get("known_hosts", "~/.ssh/known_hosts"), project, paths)
    if not os.path.isfile(known):
        raise ConfigError(f"ssh.known_hosts: {clean(known)} is missing: the sandbox's ssh "
                          f"checks host keys against it")
    sock = os.path.join(plan.runtime, "ssh-agent.sock")
    # -P none: the sandbox may only use this key, never make the agent load PKCS#11/FIDO
    # providers on the host.
    try:
        out = subprocess.run(["ssh-agent", "-s", "-P", "none", "-a", sock], check=True,
                             capture_output=True, text=True).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        raise ConfigError(f"could not start ssh-agent: {e}")
    match = re.search(r"SSH_AGENT_PID=(\d+)", out, re.ASCII)
    if not match:
        raise ConfigError("could not start ssh-agent")
    agent_pid = int(match.group(1))
    try:  # the agent holds the key once added: never leave it running if we don't return it
        if subprocess.run(["ssh-add", key], env={**os.environ, "SSH_AUTH_SOCK": sock}).returncode:
            raise ConfigError(f"ssh-add {key} failed")
        try:
            shutil.copyfile(known, os.path.join(plan.runtime, "known_hosts"))
        except OSError as e:
            raise ConfigError(f"cannot copy {clean(known)}: {e.strerror}")
    except BaseException:
        stop_process(agent_pid)
        raise
    add_ssh(plan)
    return agent_pid


def add_ssh(plan):
    """Mounts and environment for the agent socket and known_hosts in the runtime dir."""
    sock = os.path.join(plan.runtime, "ssh-agent.sock")
    plan.mount(SANDBOX_RUN + "/ssh-agent.sock", 1,
               ["--bind", sock, SANDBOX_RUN + "/ssh-agent.sock"])
    known = os.path.join(plan.runtime, "known_hosts")
    plan.mount(SANDBOX_RUN + "/known_hosts", 2, ["--ro-bind", known, SANDBOX_RUN + "/known_hosts"])
    if os.path.exists("/etc/ssh/ssh_config"):
        plan.mount("/etc/ssh/ssh_config", 2,
                   ["--ro-bind", "/etc/ssh/ssh_config", "/etc/ssh/ssh_config"])
    proxy_cmd = f"{SANDBOX_PYTHON} -I {SANDBOX_RUN}/bridge.py connect %h %p"
    plan.env["SSH_AUTH_SOCK"] = SANDBOX_RUN + "/ssh-agent.sock"
    plan.env["GIT_SSH_COMMAND"] = shlex.join([
        "ssh", "-o", f"ProxyCommand={proxy_cmd}", "-o", "StrictHostKeyChecking=yes",
        "-o", f"UserKnownHostsFile={SANDBOX_RUN}/known_hosts"])


# -- commands --------------------------------------------------------------------------

def make_runtime_dir():
    """Private host-side dir for the proxy socket. Kept short: UNIX socket paths max out at
    107 bytes. Never visible in the sandbox, which gets its own /run and /tmp."""
    xdg = os.environ.get("XDG_RUNTIME_DIR", "")
    base = xdg if os.path.isabs(xdg) and os.path.isdir(xdg) else tempfile.gettempdir()
    runtime = tempfile.mkdtemp(prefix="pithos-", dir=base)  # mode 0700
    if len(os.path.join(runtime, "ssh-agent.sock")) > 100:
        shutil.rmtree(runtime)
        raise ConfigError(f"runtime dir path too long for a UNIX socket: {runtime}")
    return runtime


def resolve_project(value):
    return os.path.realpath(value or os.getcwd())


def pick_profile(profile, cmd, paths):
    """(profile, command). Without -p, the profile named after the command if there is one,
    else base; without a command, the profile's own agent (or a shell for base)."""
    cmd = cmd[1:] if cmd[:1] == ["--"] else cmd
    if profile is None:
        guess = os.path.basename(cmd[0]) if cmd else ""
        found = PROFILE_NAME.match(guess) and os.path.exists(
            os.path.join(paths.config, guess + ".toml"))
        profile = guess if found else "base"
    if not cmd:
        cmd = [profile] if profile != "base" else ["/bin/bash"]
    return profile, cmd


class Tools:
    """The host programs a run uses. strace is set when the file notice traces the sandbox;
    systemd_run when the sandbox gets a scope."""

    def __init__(self, bwrap, strace=None, file_notice=False, systemd_run=None):
        self.bwrap, self.strace, self.systemd_run = bwrap, strace, systemd_run
        self.file_notice = file_notice


def find_tools(args, cfg):
    bwrap = os.environ.get("PITHOS_BWRAP") or shutil.which("bwrap")
    if not bwrap:
        raise ConfigError("bubblewrap not found: sudo apt install bubblewrap")
    check_bwrap(bwrap)
    if not os.path.exists(SANDBOX_PYTHON):
        raise ConfigError(f"{SANDBOX_PYTHON} is needed inside the sandbox")

    file_notice = not args.no_file_notice and cfg.get("agent", {}).get("file_notice", True)
    strace = shutil.which("strace") if file_notice else None
    if file_notice and not strace:
        note("strace not found: the agent won't be told which file accesses the sandbox refused "
             "(sudo apt install strace, or --no-file-notice)")
        file_notice = False
    if strace and not ptrace_allowed():
        note("ptrace is restricted (kernel.yama.ptrace_scope): no file notice for the agent")
        strace, file_notice = None, False

    if args.no_limits:
        note("--no-limits: no limit on the sandbox's total memory or CPU; processes, memory per "
             "process and tmpfs sizes are still limited")
        return Tools(bwrap, strace, file_notice)
    systemd_run = find_systemd_run()
    why = check_scope(systemd_run) if not args.dry_run else (
        None if systemd_run else "systemd-run is not installed")
    if why:
        raise ConfigError(f"can't put the sandbox in a systemd scope to limit its memory and "
                          f"processes: {why}.\nRun pithos from a login session, or pass "
                          f"--no-limits to run without those limits")
    return Tools(bwrap, strace, file_notice, systemd_run)


def sandbox_argv(tools, plan, cmd, unit, env_fd=None, publish_fd=None, bind_fds=None):
    """The whole command line: systemd scope, then strace, then bwrap."""
    argv = bwrap_argv(tools.bwrap, plan, plan.project, cmd, env_fd, publish_fd, bind_fds)
    if tools.strace:
        argv = strace_argv(tools.strace, os.path.join(plan.runtime, TRACE_FIFO), argv)
    if tools.systemd_run:
        argv = scope_argv(tools.systemd_run, unit, plan.limits) + argv
    return argv


ENV_PIPE_MAX = 60000  # written whole before bwrap reads it: must fit the pipe buffer


def env_pipe(plan):
    """The read end of a pipe holding the environment, for bwrap --args."""
    data = b"".join(arg.encode() + b"\0" for arg in env_args(plan))
    if len(data) > ENV_PIPE_MAX:
        raise ConfigError("sandbox environment too large")
    env_r, env_w = os.pipe()
    try:
        os.write(env_w, data)
    except BaseException:
        os.close(env_r)
        raise
    finally:
        os.close(env_w)
    return env_r


def cmd_run(args, paths):
    project = resolve_project(args.project)
    check_project(project, paths)
    profile, cmd = pick_profile(args.profile, args.cmd, paths)
    spec = publish.parse_spec(args.publish, reserved=(PROXY_PORT,)) if args.publish else None
    cfg = merge(load_profile(paths, profile), load_project(paths, project))
    try:
        allowlist = proxy.Allowlist(cfg.get("net", {}).get("allow", []))
    except ValueError as e:
        raise ConfigError(f"net.allow: {e}")
    tools = find_tools(args, cfg)
    limits, warnings = resolve_limits(cfg, read_machine(), scoped=bool(tools.systemd_run))
    for warning in warnings:
        note(f"WARNING: {warning}")

    runtime = make_runtime_dir()
    try:
        scoped = bool(tools.systemd_run)
        notice = (AGENT_NOTICE + (FILE_NOTICE if tools.file_notice else "")
                  + limits_notice(limits, scoped))
        plan = build_plan(cfg, project, paths, runtime, limits=limits, scoped=scoped,
                          notice=notice)
        if spec:
            add_publish(plan, spec)
            if not publish.is_loopback(spec[0]):
                note(f"WARNING: --publish {clean(args.publish)}: anyone who can reach this "
                     f"address can use the server in the sandbox; keep its password on")
        write_runtime_files(runtime, notice)
        if args.verbose or args.dry_run:
            note(f"limits: {describe_limits(limits)}")
        if args.verbose:
            for line in plan.skipped:
                note(f"skipped {line}")
        if args.dry_run:
            if "key" in cfg.get("ssh", {}):
                add_ssh(plan)  # what start_ssh_agent adds, without starting the agent
            argv = sandbox_argv(tools, plan, agent_command(cfg, cmd), "pithos-<session>.scope")
            print(shlex.join(argv))
            return 0
        return run_session(args, paths, tools, cfg, plan, profile, cmd, allowlist)
    finally:
        shutil.rmtree(runtime, ignore_errors=True)


def start_file_notice(paths, tools, plan, log):
    """The TraceWatcher for the file notice, or None."""
    if not tools.strace:
        return None
    fifo = os.path.join(plan.runtime, TRACE_FIFO)
    os.mkfifo(fifo, 0o600)
    denied = BlockedFiles(os.path.join(plan.runtime, "blocked-files") if tools.file_notice
                          else None, paths.home)
    watcher = TraceWatcher(fifo, SandboxView(plan, paths.home), denied,
                           log if tools.file_notice else None)
    watcher.start()
    return watcher


def start_scope_monitor(pid, unit, events):
    cgroup = scope_cgroup(pid, unit)
    if not cgroup:
        note("WARNING: can't find the sandbox's scope: limits apply, but the agent won't be told "
             "when one is hit")
        return None
    monitor = ScopeMonitor(cgroup, events)
    monitor.start()
    return monitor


def run_session(args, paths, tools, cfg, plan, profile, cmd, allowlist):
    """Start the proxy and the helpers, run the sandbox, then clean up. Returns its exit code."""
    project, runtime, limits = plan.project, plan.runtime, plan.limits
    os.makedirs(paths.logs, mode=0o700, exist_ok=True)
    make_dirs(plan)
    session = time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3)
    with contextlib.ExitStack() as cleanup:  # undoes each step below in reverse, however we exit
        register_session(paths, session, project)
        cleanup.callback(remove_file, paths.session_file(session))

        live = proxy.LiveAllowlist(allowlist, [paths.session_file(session), paths.allowed],
                                   lambda: read_live_entries(paths, session, project))
        server = proxy.ProxyServer(live, log_path=os.path.join(paths.logs, session + ".jsonl"),
                                   blocked_path=os.path.join(runtime, "blocked-hosts"))
        live.log = log = server.log
        log(action="start", profile=profile, project=project, cmd=cmd,
            rules=rule_snapshot(cfg), limits=limits, scoped=plan.scoped)
        live.refresh()
        for problem in live.problems:
            note(f"WARNING: {clean(problem)}")
        if live.entries:
            note(f"hosts saved for this project: {clean(' '.join(live.entries))}")
        server.start(os.path.join(runtime, "proxy.sock"))
        cleanup.callback(server.stop)

        agent_pid = start_ssh_agent(cfg, project, paths, plan)
        if agent_pid:
            cleanup.callback(stop_process, agent_pid)
        watcher = start_file_notice(paths, tools, plan, log)
        if watcher:
            cleanup.callback(watcher.finish, timeout=1)
        publish_fd = None
        if plan.publish:
            addr, port = plan.publish
            published = publish.PublishServer(addr, port, os.path.join(runtime, "publish.sock"), log)
            publish_fd = published.start()  # closed once bwrap has its copy, below
            cleanup.callback(published.stop)
            note(f"published: http://{f'[{addr}]' if ':' in addr else addr}:{port}/")

        child = None

        def on_signal(signum, _frame):
            """Outlive ^C and hangups, so the cleanup runs: the terminal signals the sandbox's
            process group itself, unless bwrap --new-session cut it off. SIGTERM is passed on.
            Handlers, unlike SIG_IGN, reset on exec; if we are killed anyway, bwrap's
            --die-with-parent takes the sandbox down."""
            if child and signum == signal.SIGTERM:
                child.send_signal(signum)

        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, on_signal)
        set_window_title(os.path.basename(cmd[0]))
        unit = f"pithos-{session}.scope"
        # Only bwrap keeps these: the launcher holding the publish channel's sandbox end would
        # hide a dead bridge from PublishServer.
        passed = [] if publish_fd is None else [publish_fd]
        try:
            passed.append(env_r := env_pipe(plan))
            bind_fds = open_binds(plan)  # last: the shorter the wait before bwrap, the better
            passed += bind_fds.values()
            argv = sandbox_argv(tools, plan, agent_command(cfg, cmd), unit, env_r,
                                publish_fd, bind_fds)
            child = subprocess.Popen(argv, pass_fds=passed)
        finally:
            close_fds(passed)

        events = LimitEvents(os.path.join(runtime, "limit-events"), limits, log)
        monitor = start_scope_monitor(child.pid, unit, events) if tools.systemd_run else None
        if monitor:
            cleanup.callback(monitor.stop)
        code = child.wait()
        if monitor:
            monitor.stop()  # reads the counters one last time, while the scope still exists
        for kind, count in sorted(events.totals.items()):
            note(f"{limit_hit_text(kind, count, limits)}; see pithos report")
        if watcher:
            watcher.finish()
        log(action="exit", code=code)
        for path in quarantine(plan, session):
            log(action="quarantine", path=path)
            note(f"WARNING: the sandbox created a protected path; moved to {clean(path)}")
        return code if code >= 0 else 128 - code  # killed by signal N: 128 + N, like a shell


def remove_file(path):
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)


def cmd_trust(args, paths):
    project = resolve_project(args.project)
    check_project(project, paths)
    raw, digest = read_project_file(project)
    if raw is None:
        raise ConfigError(f"{project} has no {PROJECT_FILE}")
    data = parse_project_file(project, raw)
    print(f"--- {project}/{PROJECT_FILE}")
    print(clean(raw.decode("utf-8")))
    print("--- adds:")
    for section, keys in data.items():
        for key, value in keys.items():
            print(f"  {section}.{key}: {clean(json.dumps(value))}")
    if not args.yes:
        if not sys.stdin.isatty():
            raise ConfigError("not a terminal: pass --yes to trust non-interactively")
        if input("Trust this file? [y/N] ").strip().lower() != "y":
            return 1
    trusted = read_trusted(paths)
    trusted[project] = digest
    os.makedirs(paths.state, mode=0o700, exist_ok=True)
    write_private_json(paths.trusted, trusted)
    print(f"trusted {project}/{PROJECT_FILE}")
    return 0


def allow_list(paths, sessions, project):
    for session, record in sessions.items():
        print(clean(f"session {session}: {json.dumps(record.get('allow', []))}"))
    if not sessions:
        print("no running session in this project")
    saved = (read_json_table(paths.allowed) or {}).get(project, [])
    print(clean(f"saved for this project: {json.dumps(saved)}"))
    return 0


def allow_remove(paths, sessions, project, raw):
    removed = set()

    def change(old):
        kept = [e for e in old if not any(same_entry(e, r) for r in raw)]
        removed.update(e for e in old if e not in kept)
        return kept

    update_entries(paths, sessions, project, change, save=True)
    if not removed:
        raise ConfigError(f"not approved with `pithos allow`: {' '.join(raw)} "
                          "(hosts in a profile or .pithos.toml are removed there)")
    print(clean(f"removed {' '.join(sorted(removed))}; connections already open stay open"))
    return 0


def allow_prompt(paths, sessions, project):
    pending = pending_hosts(paths, sessions, project)
    if not pending:
        print("no denied hosts are waiting")
        return 0
    interactive = sys.stdin.isatty()
    for entry, count in pending[:PENDING_SHOWN]:
        line = clean(f"{entry} ({count}x)")
        if not interactive:
            print(line)
            continue
        try:
            answer = input(f"{line} allow? [y]es / [s]ave / [N]o ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
        if answer in ("y", "s"):
            add_entries(paths, sessions, project, [entry], save=answer == "s")
    if len(pending) > PENDING_SHOWN:
        print(f"and {len(pending) - PENDING_SHOWN} more: see pithos log --denied")
    if not interactive:
        print("not a terminal, nothing approved: run pithos allow HOST[:PORT]")
    return 0


def cmd_allow(args, paths):
    if os.environ.get("PITHOS"):
        raise ConfigError("pithos allow must run outside the sandbox, in another terminal")
    if args.save + args.remove + args.list > 1:
        raise ConfigError("use only one of --save, --remove and --list")
    if args.list and args.hosts:
        raise ConfigError("--list takes no hosts")
    if (args.save or args.remove) and not args.hosts:
        raise ConfigError("--save and --remove need at least one host")
    project = resolve_project(args.project)
    check_project(project, paths)
    running = running_sessions(paths)
    sessions = {k: v for k, v in running.items() if v["project"] == project}
    if args.list:
        return allow_list(paths, sessions, project)
    if args.remove:
        return allow_remove(paths, sessions, project, args.hosts)
    if not sessions and not args.save:
        others = sorted({v["project"] for v in running.values()})
        raise ConfigError(f"no running session in {project}. Use -C PROJECT or --save. "
                          f"Running in: {', '.join(others) or 'nothing'}")
    if not args.hosts:
        return allow_prompt(paths, sessions, project)
    entries = []
    for raw in args.hosts:
        try:
            entries.append(proxy.check_live_entry(raw))
        except ValueError as e:
            raise ConfigError(f"{raw}: {e}")
    add_entries(paths, sessions, project, list(dict.fromkeys(entries)), args.save)
    return 0


def cmd_log(args, paths):
    files = sorted(glob.glob(os.path.join(glob.escape(paths.logs), "*.jsonl")))
    if not files:
        print("no sessions logged yet")
        return 0
    if not args.all:
        files = files[-1:]
    denied = {}
    for path in files:
        for event in read_session(path):
            if args.denied:
                if event.get("action") == "deny":
                    key = (str(event.get("host")), str(event.get("port")))
                    denied.setdefault(key, [0, str(event.get("reason"))])[0] += event_weight(event)
            else:
                print(clean(" ".join(f"{k}={v}" for k, v in event.items())))
    if args.denied:
        if not denied:
            print("nothing denied")
            return 0
        print("# add to [net] allow in the profile or .pithos.toml if expected,")
        print("# or approve for a running session with: pithos allow HOST[:PORT]")
        for (host, port), (count, reason) in sorted(denied.items()):
            print(clean(f'  "{proxy.live_entry(host, port)}",   # {count}x, {reason}'))
    return 0


def parse_args(argv):
    if argv and argv[0] in COMMANDS:
        command, argv = argv[0], argv[1:]
    else:
        command = "run"
    parser = argparse.ArgumentParser(prog=f"pithos {command}", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    if command in ("run", "trust", "allow"):
        parser.add_argument("-C", "--project", help="project directory (default: cwd)")
    if command == "run":
        parser.add_argument("-p", "--profile", help="profile name (default: guessed from CMD)")
        parser.add_argument("--dry-run", action="store_true", help="print the bwrap command")
        parser.add_argument("--no-limits", action="store_true",
                            help="run even without a systemd scope: no limit on total memory "
                                 "or CPU")
        parser.add_argument("--no-file-notice", action="store_true",
                            help="don't trace refused file accesses for the agent (faster builds)")
        parser.add_argument("--publish", metavar="[IP:]PORT",
                            help="let the host reach a server inside the sandbox on PORT "
                                 "(on 127.0.0.1 unless IP is given)")
        parser.add_argument("-v", "--verbose", action="store_true")
        parser.add_argument("cmd", nargs=argparse.REMAINDER)
    elif command == "trust":
        parser.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    elif command == "allow":
        parser.add_argument("hosts", nargs="*", metavar="HOST[:PORT]",
                            help="host to allow; without one, asks about denied hosts")
        parser.add_argument("--save", action="store_true",
                            help="also keep for future sessions of this project")
        parser.add_argument("--remove", action="store_true",
                            help="revoke from running sessions and the saved list")
        parser.add_argument("--list", action="store_true", help="show approved hosts")
    elif command == "report":
        which = parser.add_mutually_exclusive_group()
        which.add_argument("--session", metavar="ID", help="report on this session (default: latest)")
        which.add_argument("--all", action="store_true", help="combine all sessions")
    else:
        parser.add_argument("--denied", action="store_true", help="summarise denied hosts")
        parser.add_argument("--all", action="store_true", help="all sessions, not only the last")
    args = parser.parse_args(argv)
    return command, args


def main(argv):
    command, args = parse_args(argv)
    try:
        paths = Paths()
        commands = {"run": cmd_run, "trust": cmd_trust, "log": cmd_log, "allow": cmd_allow,
                    "report": cmd_report}
        return commands[command](args, paths)
    except ConfigError as e:
        note(clean(e))
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
